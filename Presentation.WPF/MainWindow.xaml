<!--
    Este es el punto de entrada de la app es decir esta es la ventana principal y lo que esta en la carpeta de /Views son 
    componentes reutilizables que incrustran aqui en esta ventana principal. 
    
    En esta ventana principal se coloca lo que no cambia en ninguna otra vista como el menu, logos, Botones para minimizar,cerrar y maximizar la app
    cosas que siempre vera el usuario.
-->
<Window x:Class="Presentation.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:Presentation.WPF"
        xmlns:views="clr-namespace:Presentation.WPF.Views"
        xmlns:viewmodels="clr-namespace:Presentation.WPF.ViewModels"
        xmlns:alertas="clr-namespace:Presentation.WPF.Views.Alertas"
        mc:Ignorable="d"
        Title=" POS - UNA MORDIDA " Height="1024" Width="1280"
        Icon="/Assets/Imagenes/Logo.ico">

    <Window.InputBindings>
        <KeyBinding Key="F12" Command="{Binding AbrirCajonCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:MenuViewModel}">
            <views:MenuView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:ComandaViewModel}">
            <views:Comanda />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:ConfiguracionMenuViewModel}">
            <views:ConfiguracionMenuViewModel/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:CierreDeCajaViewModel}">
            <views:CierreDeCaja/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:CuentasAbiertasViewModel}">
            <views:CuentasAbiertasView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:FinalizarCompraViewModel}">
            <views:FinalizarCompra />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:ConfiguracionAvanzadaViewModel}">
            <views:ConfiguracionAvanzadaView />
        </DataTemplate>

    </Window.Resources>


    <Grid>


        <!--#region Estructura -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="190" MaxWidth="240"/>
            <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>
        <!--#endregion-->


        <!--#region Panel Izquierdo -->
        <Border Grid.Column="0" Background="{StaticResource Amarillo claro_fuerte}" BorderBrush="Gray" BorderThickness="0,0,3,0" >
            <Grid>


                <!--#region Estructura -->
                <Grid.RowDefinitions>
                    <RowDefinition Height = "Auto" MaxHeight="135" />
                    <RowDefinition Height = "*" MinHeight="60" />
                    <RowDefinition Height = "*" MinHeight="60" />
                    <RowDefinition Height = "*" MinHeight="60" />
                    <RowDefinition Height = "*" MinHeight="60" />
                </Grid.RowDefinitions>
                <!--#endregion-->


                <!--#region Logotipo / Botón Home-->
                <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="0,0,0,2" Padding="8,6">
                    <Button Command="{Binding ShowHomeCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Ir al Inicio / Dashboard">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="4">
                                    <Image Source="/Assets/Imagenes/Logo.png" MaxHeight="115" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource Blanco 70%}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>
                <!--#endregion-->


                <!--#region RadioButton (Menu,Configuracion de Menu,Cierre de caja y Ventas)-->
                <RadioButton GroupName="NavegacionPrincipal" Style="{StaticResource BtnBarraLateral}" Grid.Row="1" Content="Menú" Command="{Binding ShowMenuCommand}" IsChecked="{Binding EsMenuSeleccionado, Mode=OneWay}"/>

                <RadioButton GroupName="NavegacionPrincipal" Style="{StaticResource BtnBarraLateral}" Grid.Row="2" Content="Cuentas&#x0a;Abiertas" Command="{Binding ShowCuentasAbiertasCommand}" IsChecked="{Binding EsCuentasSeleccionado, Mode=OneWay}"/>

                <RadioButton GroupName="NavegacionPrincipal" Style="{StaticResource BtnBarraLateral}" Grid.Row="3" Content="Cierre de caja" Command="{Binding ShowCierreDeCajaCommand}" IsChecked="{Binding EsCierreSeleccionado, Mode=OneWay}"/>

                <RadioButton GroupName="NavegacionPrincipal" Style="{StaticResource BtnBarraLateral}" Grid.Row="4" Content="Configuración &#x0a;de menú" Command="{Binding ShowConfigMenuCommand}" IsChecked="{Binding EsConfigSeleccionado, Mode=OneWay}"/>
                <!--#endregion-->


            </Grid>
        </Border>
        <!--#endregion-->


        <!--#region Panel Derecho -->
        <Border Grid.Column="1" Background="{StaticResource Amarillo claro_bajo}">
            <Grid>

                
                <!--#region Vista Actual-->
                <ContentControl Grid.Row="1" Content="{Binding VistaActual}"/>
                <!--#endregion-->
                

            </Grid>
        </Border>
        <!--#endregion-->

        <!--#region Notificaciones Flotantes (Toasts No Bloqueantes) -->
        <alertas:NotificacionesOverlay Grid.ColumnSpan="2" 
                                      HorizontalAlignment="Right" 
                                      VerticalAlignment="Top" 
                                      Margin="0,18,22,0" 
                                      Panel.ZIndex="999"/>
        <!--#endregion-->

    </Grid>
    

</Window>