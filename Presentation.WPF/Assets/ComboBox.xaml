<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ComboBoxCuentas" TargetType="ComboBox">

        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Gris}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Height" Value="38"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="ComboBox">

                    <Grid>

                        <!-- Botón que muestra la opción seleccionada -->
                        <ToggleButton
                        x:Name="ToggleButton"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}"
                        Cursor="Hand"
                        IsChecked="{Binding IsDropDownOpen,
                                            RelativeSource={RelativeSource TemplatedParent}}"
                        Focusable="False">

                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">

                                    <Border
                                    x:Name="ToggleBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Cuenta seleccionada -->
                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding SelectedItem.Titulo, RelativeSource={RelativeSource AncestorType=ComboBox}, TargetNullValue='Nueva Cuenta', FallbackValue='Nueva Cuenta'}"
                                                       FontFamily="{StaticResource Fuente-principal}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- Flecha -->
                                            <Path
                                            Grid.Column="1"
                                            Data="M 0 0 L 8 0 L 4 5 Z"
                                            Fill="{StaticResource Gris}"
                                            Width="10"
                                            Height="6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="10,0,2,0"/>

                                        </Grid>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ToggleBorder"
                                                Property="BorderBrush"
                                                Value="{StaticResource Naranja claro}"/>
                                        </Trigger>

                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ToggleBorder"
                                                Property="BorderBrush"
                                                Value="{StaticResource Naranja claro}"/>
                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </ToggleButton.Template>

                        </ToggleButton>


                        <!-- Lista desplegable -->
                        <Popup
                        x:Name="PART_Popup"
                        AllowsTransparency="True"
                        IsOpen="{TemplateBinding IsDropDownOpen}"
                        Placement="Bottom"
                        PopupAnimation="Slide">

                            <Border
                            Background="White"
                            BorderBrush="{StaticResource Gris}"
                            BorderThickness="2"
                            CornerRadius="7"
                            Margin="0,3,0,0"
                            MinWidth="{Binding ActualWidth,
                                RelativeSource={RelativeSource TemplatedParent}}">

                                <ScrollViewer
                                MaxHeight="250"
                                VerticalScrollBarVisibility="Auto">

                                    <ItemsPresenter/>

                                </ScrollViewer>

                            </Border>

                        </Popup>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

        <!-- Estilo de cada elemento de la lista -->
        <Setter Property="ItemContainerStyle">

            <Setter.Value>

                <Style TargetType="ComboBoxItem">

                    <Setter Property="FontFamily"
                        Value="{StaticResource Fuente-principal}"/>

                    <Setter Property="FontSize"
                        Value="14"/>

                    <Setter Property="Padding"
                        Value="10,8"/>

                    <Setter Property="HorizontalContentAlignment"
                        Value="Left"/>

                    <Setter Property="Background"
                        Value="White"/>

                    <Setter Property="Foreground"
                        Value="Black"/>

                    <Setter Property="Template">

                        <Setter.Value>

                            <ControlTemplate TargetType="ComboBoxItem">

                                <Border
                                x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">

                                    <ContentPresenter
                                    VerticalAlignment="Center"/>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver"
                                         Value="True">

                                        <Setter TargetName="ItemBorder"
                                            Property="Background"
                                            Value="{StaticResource Naranja 50%}"/>

                                    </Trigger>

                                    <Trigger Property="IsSelected"
                                         Value="True">

                                        <Setter TargetName="ItemBorder"
                                            Property="Background"
                                            Value="{StaticResource Naranja 50%}"/>

                                        <Setter Property="FontWeight"
                                            Value="SemiBold"/>

                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Setter.Value>

                    </Setter>

                </Style>

            </Setter.Value>

        </Setter>

    </Style>
</ResourceDictionary>