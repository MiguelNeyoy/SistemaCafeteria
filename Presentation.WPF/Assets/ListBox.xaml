<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--#region Lista de categorias -->
    <Style x:Key="ListaCategorias" TargetType="ListBox">

        <Setter Property="Background" Value="Transparent"/>

        <Setter Property="BorderThickness" Value="0"/>

        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

        <Setter Property="ItemContainerStyle">

            <Setter.Value>

                <Style TargetType="ListBoxItem">

                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                    <Setter Property="Margin" Value="3"/>

                </Style>
                
            </Setter.Value>
            
        </Setter>

        <Setter Property="ItemTemplate">

            <Setter.Value>

                <DataTemplate>

                    <Border Margin="5" Padding="10" BorderThickness="1" BorderBrush="Gray" CornerRadius="10" >

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>


                            <!--Nombre-->
                            <TextBlock Text="{Binding Nombre}"
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="20" FontWeight="SemiBold"/>


                            <!--Boton de edicion-->
                            <Button Grid.Column="1" Style="{StaticResource BotonEdicion}"
                                    Height="40" Width="40"
                                    Command="{Binding DataContext.EditarCategoriaCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}">
                                
                                <Image Grid.Column="1" Source="/Assets/Imagenes/Icono_de_editar.png" Height="20" Width="20"/>

                            </Button>

                        </Grid>

                    </Border>

                </DataTemplate>
                
            </Setter.Value>
            
        </Setter>

    </Style>
    <!--#endregion-->
    
    
    <!--#region Lista de productos-->
    <Style x:Key="ListaProductos" TargetType="ListBox">

        <Setter Property="Background" Value="Transparent"/>

        <Setter Property="BorderThickness" Value="0"/>

        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

        <Setter Property="ItemContainerStyle">

            <Setter.Value>

                <Style TargetType="ListBoxItem">

                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                    <Setter Property="Margin" Value="3"/>

                </Style>
                
            </Setter.Value>
            
        </Setter>


        <Setter Property="ItemTemplate">

            <Setter.Value>

                <DataTemplate>

                    <Border Margin="5" Padding="10" BorderThickness="1" BorderBrush="Gray" CornerRadius="10" >

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>


                            <!--Nombre-->
                            <TextBlock Text="{Binding Nombre}"
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="20" FontWeight="SemiBold"/>


                            <!--Boton de edicion-->
                            <Button Grid.Column="1" Style="{StaticResource BotonEdicion}"
                                    Height="40" Width="40"
                                    Command="{Binding DataContext.EditarProductoCommand,RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}">

                                <Image Source="/Assets/Imagenes/Icono_de_editar.png" Height="20" Width="20"/>

                            </Button>


                            <!--Boton de eliminacion-->
                            <Button Grid.Column="2" Style="{StaticResource BtnBasura}"
                                    Height="40" Width="40">

                                <Image Source="/Assets/Imagenes/Icono_basura.png" Height="20" Width="20"/>

                            </Button>


                        </Grid>

                    </Border>

                </DataTemplate>

            </Setter.Value>

        </Setter>

        <Style.Triggers>

            <DataTrigger Binding="{Binding TieneProductosCategoria}" Value="False">

                <Setter Property="Visibility" Value="Collapsed"/>

            </DataTrigger>
            
        </Style.Triggers>

    </Style>
    <!--#endregion-->
    
</ResourceDictionary>