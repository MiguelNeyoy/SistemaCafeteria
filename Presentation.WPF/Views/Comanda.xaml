<UserControl x:Class="Presentation.WPF.Views.Comanda"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Presentation.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="1024" d:DesignWidth="900">

    <Grid>
        
        <!--#region Estructura Inicial-->
        <Grid.RowDefinitions>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--#endregion-->
        
        <!--#region Fila Superior ( Boton de retroceso, Categorias)-->
        <Grid Grid.Row="0" >

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            
            <!--#region Boton de retroceso-->
            <Button Grid.Column="0" Style="{StaticResource BotonRetroceso}" Height="80" Width="120" Margin="15,0,15,0">
                <Image Source="/Assets/Imagenes/Icono_retroceso.png" Stretch="Uniform"/>
            </Button>
            <!--#endregion-->

        </Grid>
        <!--#endregion-->
        
        <!--#region Fila Inferior (Comanda, Productos) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            

            <!--#region Comanda-->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                
                
                <!--#region Fila 0( Titulo, Numero de ticket y boton para eliminar comanda )-->
                <Border Grid.Row="0" Background="White" BorderBrush="Gray" BorderThickness="0,0,0,1">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock HorizontalAlignment="Center" FontSize="26" FontFamily="{StaticResource Fuente-principal}"> Comanda </TextBlock>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock HorizontalAlignment="Left" FontSize="20" FontFamily="{StaticResource Fuente-principal}"> Numero Ticket #</TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding numeroTicket}" HorizontalAlignment="Left" FontSize="18" FontFamily="{StaticResource Fuente-principal}" />

                            </Grid>

                        </Grid>

                        <Grid Grid.Column="1">
                            <Button Style="{StaticResource BtnBasura}">
                                <Image Source="/Assets/Imagenes/Icono_basura.png" Height="50" Width="50"/>
                            </Button>
                        </Grid>

                    </Grid>

                </Border>
                <!--#endregion-->
                

                <!--#region Fila 1( Productos que se añaden a la comanda )-->
                <ListBox Grid.Row="1">
                    
                </ListBox>
                <!--#endregion-->
                

                <!--#region Fila 2( Total,Comentario, Precio y Finalizar )-->
                <Border Grid.Row="2" Background="#fbfbe2" >

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock FontSize="20" FontFamily="{StaticResource Fuente-principal}" Margin="0,0,0,15"> Total </TextBlock>

                            <Button Grid.Row="1" Style="{StaticResource BtnComentario}" Height="40" Width="120" FontSize="20" FontFamily="{StaticResource Fuente-principal}" HorizontalAlignment="Left"> Comentario </Button>
                            
                        </Grid>

                        <Grid Grid.Column="1" Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding TotalComanda}"  FontSize="20" FontFamily="{StaticResource Fuente-principal}" Margin="0,0,0,15"/>

                            <Button Grid.Row="1" Style="{StaticResource BtnFinalizar}" Height="40" Width="120" FontSize="20" FontFamily="{StaticResource Fuente-principal}" HorizontalAlignment="Right" > Finalizar </Button>

                        </Grid>
                    </Grid>

                </Border>
                <!--#endregion-->

            </Grid>
            <!--#endregion-->
            
            
            <!--#region Productos -->
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1,0,0,0" Background="white">
                <Grid>

                    <ScrollViewer>

                        <ItemsControl ItemsSource="{Binding ProductoCategoriaSeleccionada}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Button Style="{StaticResource BtnComandaProducto}" Height="170" Width="170">

                                        <StackPanel>

                                            <TextBlock Text="{Binding Nombre}"
                                                       HorizontalAlignment="Left"
                                                       TextWrapping="Wrap"
                                                       FontFamily="{StaticResource Fuente-principal}"
                                                       FontSize="20"/>

                                            <TextBlock Text="{Binding Precio}"
                                                       Background="{StaticResource Precio-productos}"
                                                       HorizontalAlignment="Left"
                                                       FontFamily="{StaticResource Fuente-principal}"
                                                       FontSize="18"/>

                                        </StackPanel>
                                        
                                    </Button>
                                    
                                </DataTemplate>
                                
                            </ItemsControl.ItemTemplate>
                            
                        </ItemsControl>
                        
                    </ScrollViewer>
                    
                </Grid>
                
            </Border>
            <!--#endregion-->
            
        </Grid>
        <!--#endregion-->
        
    </Grid>
</UserControl>