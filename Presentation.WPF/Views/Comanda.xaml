    <UserControl x:Class="Presentation.WPF.Views.Comanda"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Presentation.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="1024" d:DesignWidth="1000">

    <Grid>
        
        
        <!--Estructura -->
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        
        <!--#region Panel Superior-->
        <Border Grid.Row="0" BorderThickness="0,0,0,3" BorderBrush="Gray">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                
                <!--Boton de retroceso-->
                <Button Command="{Binding RegresarCommand}"
                        Grid.Column="0"
                        Style="{StaticResource BotonRetroceso}" 
                        Height="65" Width="120" Margin="15,0,0,5" HorizontalAlignment="Left">
                    
                    <Image Source="/Assets/Imagenes/Icono_retroceso.png" Stretch="Uniform"/>
                    
                </Button>
                
                
                <!-- Categoria Actual-->
                <Border Grid.Column="1" Height="65" HorizontalAlignment="Center" Width="auto" Background="{StaticResource Naranja 90%}" CornerRadius="10">
                    
                    <TextBlock Text="{Binding CategoriaSeleccionada.Nombre}"
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="28" FontWeight="SemiBold"
                               Padding="25"
                               VerticalAlignment="Center"/>
                </Border>
                
            </Grid>

        </Border>
        <!--#endregion-->
        
        
        <!--#region Panel Inferior -->
        <Grid Grid.Row="1">
            
            
            <!--Estructura -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!--#region Comanda-->
            <Grid Grid.Column="0">
                
                
                <!--Estructura -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>


                <Border Grid.Row="0" Background="White" BorderBrush="Gray" BorderThickness="0,0,0,1">

                    <Grid>
                        
                        
                        <!--Estructura -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>


                        <Grid Grid.Column="0">


                            <!--Estructura-->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>


                            <!--Titulo-->
                            <TextBlock HorizontalAlignment="Center" FontSize="28" FontFamily="{StaticResource Fuente-principal}" FontWeight="SemiBold"> Comanda </TextBlock>
                            

                            <Grid Grid.Row="1">
                                
                                
                                <!--Estructura-->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>


                                <!--Numero Ticket-->
                                <TextBlock FontSize="18" FontFamily="{StaticResource Fuente-principal}" FontWeight="SemiBold" Margin="10,0,0,6">Ticket #</TextBlock>
                                
                                <TextBlock Grid.Column="1" Text="{Binding NumeroTicket}" FontFamily="{StaticResource Fuente-principal}" FontSize="16" FontWeight="SemiBold" />

                            </Grid>

                        </Grid>

                        <Grid Grid.Column="1">
                            
                            
                            <!--Boton de basura-->
                            <Button Style="{StaticResource BtnBasura}" Command="{Binding LimpiarComandaCommand}">
                                <Image Source="/Assets/Imagenes/Icono_basura.png" Height="50" Width="50"/>
                            </Button>
                            
                        </Grid>

                    </Grid>

                </Border>


                <!--Lista Comanda-->
                <ListBox Grid.Row="1" Style="{StaticResource ListaComanda}" ItemsSource="{Binding ItemsComanda}" SelectedItem="{Binding ItemSeleccionado, Mode=TwoWay}"/>
                

                <!--#region Barra inferior-->
                <Border Grid.Row="2" Background="#fbfbe2" BorderBrush="Gray" BorderThickness="0,1,0,0">

                    <Grid Margin="0,0,0,25">
                        
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        
                        
                        <!--#region Total-->
                        <Grid Margin="20,0,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Total" 
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="26" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1" Text="{Binding TotalComanda, StringFormat={}{0:C}}"
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="24" FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                        </Grid>
                        <!--#endregion-->
                        
                        
                        <!--#region Botones-->
                        <Grid Grid.Row="1" Margin="20,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Command="{Binding MostrarOcultarComentarioCommand}"
                                    Style="{StaticResource BtnComentario}"
                                    Height="40" Width="160"
                                    FontFamily="{StaticResource Fuente-principal}"
                                    FontSize="22" FontWeight="SemiBold"
                                    HorizontalAlignment="Left">
                                
                                Comentarios
                            </Button>


                            <Button Grid.Column="1" Command="{Binding EnviarACocinaCommand}"
                                    Style="{StaticResource BtnFinalizar}"
                                    Height="40" Width="160"
                                    FontFamily="{StaticResource Fuente-principal}"
                                    FontSize="22" FontWeight="SemiBold">

                                Finalizar
                            </Button>

                            </Grid>
                        <!--#endregion-->
                  
                            
                    </Grid>
                    
                </Border>
                <!--#endregion-->

            </Grid>
            <!--#endregion-->
            
            
            <!--#region Productos -->
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1,0,0,0" Background="white">
                <Grid>

                    <ScrollViewer>

                        <ItemsControl ItemsSource="{Binding ProductoCategoriaSeleccionada}">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <WrapPanel Orientation="Horizontal" ItemHeight="170" ItemWidth="170"/>

                                </ItemsPanelTemplate>
                                
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Button Style="{StaticResource BtnComandaProducto}" 
                                            Command="{Binding DataContext.AgregarProductoCommand, RelativeSource={RelativeSource  AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding Nombre}"
                                                       FontFamily="{StaticResource Fuente-principal}"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Left"
                                                       />

                                            <Border Grid.Row="1" Background="{StaticResource Naranja pastel apagado}" HorizontalAlignment="Right" Margin="5">
                                                

                                                <TextBlock Text="{Binding Precio, StringFormat={}{0:C}}"
                                                           FontFamily="{StaticResource Fuente-principal}"
                                                           FontSize="18" FontWeight="SemiBold"/>

                                                
                                            </Border>

                                        </Grid>
                                        
                                    </Button>
                                    
                                </DataTemplate>
                                
                            </ItemsControl.ItemTemplate>
                            
                        </ItemsControl>
                        
                    </ScrollViewer>
                    
                </Grid>
                
            </Border>
            <!--#endregion-->
            
        </Grid>
        <!--#endregion-->
        
    </Grid>
</UserControl>