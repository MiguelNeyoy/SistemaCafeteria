<UserControl x:Class="Presentation.WPF.Views.Comanda"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Presentation.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="1024" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Estilo de Botón para Selección de Extras en Modal (Touch Friendly) -->
        <Style x:Key="BtnExtraCard" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="MinHeight" Value="62"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cardBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Seleccionado}" Value="True">
                                <Setter TargetName="cardBorder" Property="Background" Value="#FFF3E0"/>
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#E65100"/>
                                <Setter TargetName="cardBorder" Property="BorderThickness" Value="2.5"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="Background" Value="#FFF8E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Botón Primario para Modales (Touch Friendly) -->
        <Style x:Key="BtnModalPrimario" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Naranja}"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontFamily" Value="{StaticResource Fuente-principal}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="18,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFB300"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFA000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Botón Secundario para Modales (Touch Friendly) -->
        <Style x:Key="BtnModalSecundario" TargetType="Button">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontFamily" Value="{StaticResource Fuente-principal}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10" Padding="16,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EEEEEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!--#region Estructura Principal -->
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--#region Panel Superior-->
        <Border Grid.Row="0" BorderThickness="0,0,0,3" BorderBrush="Gray">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Botón de retroceso -->
                <Button Command="{Binding RegresarCommand}"
                        Grid.Column="0"
                        Style="{StaticResource BotonRetroceso}" 
                        Height="65" Width="120" Margin="15,0,0,5" HorizontalAlignment="Left">
                    <Image Source="/Assets/Imagenes/Icono_retroceso.png" Stretch="Uniform"/>
                </Button>

                <!-- Categoría Actual -->
                <Border Grid.Column="1" Height="65" HorizontalAlignment="Center" Width="Auto" Background="{StaticResource Naranja 90%}" CornerRadius="10">
                    <TextBlock Text="{Binding CategoriaSeleccionada.Nombre}"
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="28" FontWeight="SemiBold"
                               Padding="25"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
        <!--#endregion-->

        <!--#region Panel Inferior (Comanda y Productos) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--#region Columna Izquierda: Comanda Activa -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Encabezado de la comanda y selector de cuenta -->
                <Border Grid.Row="0" Background="White" BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="12,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Fila 1: Título y botón limpiar comanda -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock FontSize="24" FontFamily="{StaticResource Fuente-principal}" FontWeight="SemiBold" Text="Comanda"/>
                                <TextBlock FontSize="13" FontFamily="{StaticResource Fuente-principal}" Foreground="#757575" Text="Orden activa en preparacion"/>
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource BtnBasura}" Command="{Binding LimpiarComandaCommand}">
                                <Image Source="/Assets/Imagenes/Icono_basura.png" Height="40" Width="40"/>
                            </Button>
                        </Grid>

                        <!-- Fila 2: Selector de Cuenta (Nueva Cuenta o Pendiente) -->
                        <Border Grid.Row="1" Margin="0,8,0,0" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1.5" CornerRadius="8" Padding="10,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" 
                                               Text="Asignar a cuenta:" 
                                               FontFamily="{StaticResource Fuente-principal}" 
                                               FontSize="13" FontWeight="SemiBold" 
                                               Foreground="#E65100" 
                                               VerticalAlignment="Center"/>

                                    <Button Grid.Column="1"
                                            Content="Refrescar"
                                            Command="{Binding CargarCuentasDisponiblesCommand}"
                                            Background="Transparent"
                                            Foreground="#757575"
                                            BorderThickness="0"
                                            FontSize="12"
                                            FontFamily="{StaticResource Fuente-principal}"
                                            Cursor="Hand"
                                            Padding="4,2"/>
                                </Grid>

                                <ComboBox Grid.Row="1"
                                          ItemsSource="{Binding CuentasDisponibles}"
                                          SelectedItem="{Binding CuentaSeleccionadaOpcion, Mode=TwoWay}"
                                          DisplayMemberPath="Titulo"
                                          FontFamily="{StaticResource Fuente-principal}"
                                          FontSize="15" FontWeight="SemiBold"
                                          Height="38"
                                          VerticalContentAlignment="Center"
                                          HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Lista de ítems de la comanda -->
                <ListBox Grid.Row="1" 
                         Style="{StaticResource ListaComanda}" 
                         ItemsSource="{Binding ItemsComanda}" 
                         SelectedItem="{Binding ItemSeleccionado, Mode=TwoWay}"/>

                <!-- Barra inferior: Total y Acciones -->
                <Border Grid.Row="2" Background="#fbfbe2" BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="0,12,0,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Total de la comanda -->
                        <Grid Margin="20,0,20,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Total" 
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="26" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1" Text="{Binding TotalComanda, StringFormat={}{0:C}}"
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="#E65100"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Botón de Acción: Finalizar (Ocupa todo el ancho) -->
                        <Grid Grid.Row="1" Margin="15,0,15,0">
                            <!-- Botón Finalizar (Abre o acumula a la cuenta) -->
                            <Button Content="Finalizar" 
                                    Style="{StaticResource BtnFinalizar}" 
                                    FontFamily="{StaticResource Fuente-principal}"
                                    FontSize="22" FontWeight="Bold"
                                    Height="50" HorizontalAlignment="Stretch"
                                    Command="{Binding SolicitarFinalizarComandaCommand}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <!--#endregion-->

            <!--#region Columna Derecha: Catálogo de Productos -->
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1,0,0,0" Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ProductoCategoriaSeleccionada}" Padding="10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemHeight="115" ItemWidth="235"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BtnComandaProducto}" 
                                        Margin="5"
                                        Command="{Binding DataContext.AgregarProductoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid Margin="6,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Nombre del producto con salto de línea automático -->
                                        <TextBlock Text="{Binding Nombre}"
                                                   FontFamily="{StaticResource Fuente-principal}"
                                                   FontSize="18" TextWrapping="Wrap"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"
                                                   Margin="4,2,4,2"/>

                                        <!-- Precio -->
                                        <Border Grid.Row="1" Background="{StaticResource Naranja pastel apagado}" HorizontalAlignment="Right" Margin="4,2,4,4" CornerRadius="5">
                                            <TextBlock Text="{Binding Precio, StringFormat={}{0:C}}"
                                                       FontFamily="{StaticResource Fuente-principal}"
                                                       Padding="8,3"
                                                       FontSize="17" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <!--#endregion-->
        </Grid>
        <!--#endregion-->

        <!--#region MODAL 1: PERSONALIZACION DE EXTRAS (TOUCH FRIENDLY) -->
        <Grid Grid.RowSpan="2" 
              Background="#A6000000" 
              Visibility="{Binding MostrarModalExtras, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="720" 
                    MaxHeight="750" 
                    Background="White" 
                    CornerRadius="16" 
                    BorderBrush="#424242" 
                    BorderThickness="2" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Encabezado del Modal -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Personalizar Producto" 
                                   FontFamily="{StaticResource Fuente-principal}" 
                                   FontSize="26" FontWeight="Bold" 
                                   Foreground="#212121"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <!-- Si es nuevo producto -->
                            <TextBlock Text="{Binding ProductoParaPersonalizar.Nombre}" 
                                       FontFamily="{StaticResource Fuente-principal}" 
                                       FontSize="20" FontWeight="SemiBold" Foreground="#E65100"/>
                            <TextBlock Text="{Binding ProductoParaPersonalizar.Precio, StringFormat=' (Precio base: {0:C})'}" 
                                       FontFamily="{StaticResource Fuente-principal}" 
                                       FontSize="18" Foreground="#757575"/>

                            <!-- Si es edición de ítem existente -->
                            <TextBlock Text="{Binding ItemParaEditarExtras.Nombre}" 
                                       FontFamily="{StaticResource Fuente-principal}" 
                                       FontSize="20" FontWeight="SemiBold" Foreground="#E65100"/>
                            <TextBlock Text="{Binding ItemParaEditarExtras.Precio, StringFormat=' (Precio base: {0:C})'}" 
                                       FontFamily="{StaticResource Fuente-principal}" 
                                       FontSize="18" Foreground="#757575"/>
                        </StackPanel>

                        <TextBlock Text="Toca para seleccionar o deseleccionar extras:" 
                                   FontFamily="{StaticResource Fuente-principal}" 
                                   FontSize="15" Foreground="#757575" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Lista de Extras Disponibles con botones táctiles grandes -->
                    <ScrollViewer Grid.Row="1" MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <ItemsControl ItemsSource="{Binding ExtrasDisponiblesModal}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource BtnExtraCard}" 
                                            Width="320"
                                            Command="{Binding DataContext.AlternarSeleccionExtraCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding Nombre}" 
                                                       FontFamily="{StaticResource Fuente-principal}" 
                                                       FontSize="18" FontWeight="SemiBold" 
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Precio, StringFormat='+ {0:C}'}" 
                                                       FontFamily="{StaticResource Fuente-principal}" 
                                                       FontSize="17" FontWeight="Bold" 
                                                       Foreground="#E65100" 
                                                       VerticalAlignment="Center" 
                                                       Margin="10,0,0,0"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Campo para Nota / Instrucción Especial -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,14">
                        <TextBlock Text="Instrucciones especiales / notas:" 
                                   FontFamily="{StaticResource Fuente-principal}" 
                                   FontSize="15" Foreground="#616161" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding NotaPersonalizada, UpdateSourceTrigger=PropertyChanged}" 
                                 FontFamily="{StaticResource Fuente-principal}" 
                                 FontSize="16" Padding="10,8" Height="44" 
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Subtotal de la personalización -->
                    <Border Grid.Row="3" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1.5" CornerRadius="10" Padding="16,12" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Subtotal con extras:" 
                                       FontFamily="{StaticResource Fuente-principal}" 
                                       FontSize="18" FontWeight="SemiBold" Foreground="#424242" 
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding SubtotalPersonalizacion, StringFormat={}{0:C}}" 
                                       FontFamily="{StaticResource Fuente-principal}" 
                                       FontSize="26" FontWeight="Bold" Foreground="#E65100" 
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Botones de Acción del Modal Táctiles Grandes -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Content="Cancelar" 
                                Style="{StaticResource BtnModalSecundario}" 
                                Width="130" 
                                Command="{Binding CancelarModalExtrasCommand}"/>

                        <Button Grid.Column="1" 
                                Content="Sin Extras" 
                                Style="{StaticResource BtnModalSecundario}" 
                                Margin="12,0" 
                                Command="{Binding AgregarSinExtrasModalCommand}"/>

                        <Button Grid.Column="2" 
                                Content="Confirmar" 
                                Style="{StaticResource BtnModalPrimario}" 
                                Width="160" 
                                Command="{Binding ConfirmarExtrasModalCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!--#endregion-->

        <!--#region MODAL 2: ABRIR CUENTA (FINALIZAR COMANDA) -->
        <Grid Grid.RowSpan="2" 
              Background="#A6000000" 
              Visibility="{Binding MostrarModalAbrirCuenta, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="480" 
                    Background="White" 
                    CornerRadius="16" 
                    BorderBrush="#424242" 
                    BorderThickness="2" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Título -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Abrir Cuenta" 
                                   FontFamily="{StaticResource Fuente-principal}" 
                                   FontSize="26" FontWeight="Bold" 
                                   Foreground="#212121" 
                                   HorizontalAlignment="Center"/>
                        
                        <TextBlock Text="{Binding TotalComanda, StringFormat='Total de la comanda: {0:C}'}" 
                                   FontFamily="{StaticResource Fuente-principal}" 
                                   FontSize="18" FontWeight="SemiBold" 
                                   Foreground="#E65100" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Etiqueta -->
                    <TextBlock Grid.Row="1" 
                               Text="Identificador de Cliente o Mesa:" 
                               FontFamily="{StaticResource Fuente-principal}" 
                               FontSize="16" FontWeight="SemiBold" 
                               Foreground="#424242" 
                               Margin="0,0,0,8"/>

                    <!-- Campo de texto para el nombre o mesa -->
                    <TextBox Grid.Row="2" 
                             Text="{Binding IdentificadorCliente, UpdateSourceTrigger=PropertyChanged}" 
                             FontFamily="{StaticResource Fuente-principal}" 
                             FontSize="18" 
                             Padding="10,8" 
                             Height="48" 
                             VerticalContentAlignment="Center" 
                             Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="3" 
                               Text="Si se deja vacio se asignara como 'General'" 
                               FontFamily="{StaticResource Fuente-principal}" 
                               FontSize="13" 
                               Foreground="#9E9E9E" 
                               Margin="0,0,0,22"/>

                    <!-- Botones de Acción -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Content="Cancelar" 
                                Style="{StaticResource BtnModalSecundario}" 
                                Command="{Binding CancelarAbrirCuentaCommand}"/>

                        <Button Grid.Column="2" 
                                Content="Abrir Cuenta" 
                                Style="{StaticResource BtnModalPrimario}" 
                                Command="{Binding ConfirmarAbrirCuentaCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!--#endregion-->

    </Grid>
</UserControl>