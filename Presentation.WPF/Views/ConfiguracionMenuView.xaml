<UserControl x:Class="Presentation.WPF.Views.ConfiguracionMenuViewModel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Presentation.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="900">

    <Grid >

        <!--#region Estructura Inicial-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--#endregion-->
        
        <!--#region Columna Izquierda (Total de Productos, Añadir Categoria y Añadir Productos )-->
        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="Gray">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="250"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!--#region Panel Superior -->
                <Grid Grid.Row="0">

                    <!--#region Estilos-->
                    <Grid.Resources>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="10" />
                        </Style>

                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{StaticResource Fuente-principal}" />
                            <Setter Property="FontSize" Value="20" />

                        </Style>

                    </Grid.Resources>
                    <!--#endregion-->

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!--#region Total Productos-->
                    <Border Grid.Column="0" Height="170" Width="240">

                        <TextBlock > Total de Productos:</TextBlock>

                    </Border>
                    <!--#endregion-->

                    <!--#region Boton añadir categoria-->
                    <Button Grid.Column="1" Style="{StaticResource Boton añadir producto/categoria}" Height="170" Width="180">
                        
                        <StackPanel>
                            
                            <TextBlock Text="Añadir Categoria" Margin="0,0,0,10" TextWrapping="Wrap"/>

                            <Image Source="/Assets/Imagenes/Icono_de_Adicion.png" Height="100" Width="100" Stretch="Uniform" />

                        </StackPanel>
                        
                    </Button>
                    <!--#endregion-->

                    <!--#region Añadir Producto-->
                    <Button Grid.Column="2" Style="{StaticResource Boton añadir producto/categoria}" Height="170" Width="180">

                        <StackPanel>

                            <TextBlock Text="Añadir Categoria" Margin="0,0,0,10" TextWrapping="Wrap"/>

                            <Image Source="/Assets/Imagenes/Icono_de_Adicion.png" Height="100" Width="100" Stretch="Uniform" />

                        </StackPanel>

                    </Button>
                    <!--#endregion-->

                </Grid>
                <!--#endregion-->

                <!--#region Panel Inferior-->
                <Grid Grid.Row="1">

                    <Grid.Resources>
                        <Style TargetType="Border">
                            <Setter Property="Height" Value="500"/>
                            <Setter Property="Width" Value="280"/>
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>

                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{StaticResource Fuente-principal}" />
                            <Setter Property="FontSize" Value="28" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                    </Grid.Resources>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <!--#region Categorias-->
                    <Border Grid.Column="0">
                        <Grid Height="50" VerticalAlignment="Top">
                            <Border Height="auto" BorderThickness="0,0,0,1" BorderBrush="Black"  CornerRadius="0">
                                <TextBlock Text="Categorias" />
                            </Border>
                        </Grid>
                    </Border>
                    <!--#endregion-->

                    <!--#region Productos-->
                    <Border Grid.Column="1">
                        <Grid Height="50" VerticalAlignment="Top">
                            <Border Height="auto" BorderThickness="0,0,0,1" BorderBrush="Black" CornerRadius="0">
                                <TextBlock Text="Productos" />
                            </Border>
                        </Grid>
                    </Border>
                    <!--#endregion-->

                </Grid>
                <!--#endregion-->

            </Grid>
            <!--#endregion-->
        </Border>
    </Grid>
</UserControl>