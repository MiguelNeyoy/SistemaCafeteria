<UserControl x:Class="Presentation.WPF.Views.ConfiguracionMenuViewModel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Presentation.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">


    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

    </UserControl.Resources>
    
    <Grid>


        <!--Estrutura-->
        <Grid.RowDefinitions>
            <RowDefinition Height="160"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!--#region Panel de: Tarjetas informativas y Configuracion avanzada -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            
            <!--Tarjeta de productos-->
            <Border Grid.Column="0" Height="150" HorizontalAlignment="Left" Margin="20,0,0,0" Background="{StaticResource Blanco}" CornerRadius="10" BorderThickness="2" BorderBrush="Black">

                <Grid Margin="10,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!--Texto-->
                    <TextBlock Grid.Row="0" Text="Total productos:"
                           FontFamily="{StaticResource Fuente-principal}"
                           FontSize="24" FontWeight="SemiBold"
                           Padding="10"
                           HorizontalAlignment="Center"/>


                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>


                        <!--Imagen-->
                        <Image Source="/Assets/Imagenes/Icono_de_alimento.png" Stretch="Uniform"/>


                        <!--Texto-->
                        <TextBlock Grid.Column="1" Text="{Binding TotalProductos}"
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="30" FontWeight="SemiBold"
                               Margin="15,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>

                </Grid>

            </Border>

            
            <!--Tarjeta de Extra/Modificadores-->
            <Border Grid.Column="1" Height="150" HorizontalAlignment="Left" Margin="20,0,0,0" Background="{StaticResource Blanco}" CornerRadius="10" BorderThickness="2" BorderBrush="Black">

                <Grid Margin="10,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!--Texto-->
                    <TextBlock Grid.Row="0" Text="Total extras:"
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"
                               Padding="10"
                               HorizontalAlignment="Center"/>


                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>


                        <!--Imagen-->
                        <Image Source="/Assets/Imagenes/Icono_de_Adicion.png" Stretch="Uniform" Height="60"/>


                        <!--Texto-->
                        <TextBlock Grid.Column="1" Text="{Binding TotalExtras}"
                                   FontFamily="{StaticResource Fuente-principal}"
                                   FontSize="30" FontWeight="SemiBold"
                                   Margin="15,0,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>

                </Grid>

            </Border>
            
            
            <!--Boton: Configuracion Avanzada-->
            <Button Grid.Column="2" Content="⚙" Style="{StaticResource BotonRetroceso}"
                    FontSize="80"
                    Margin="0,0,20,0"
                    Height="150" Width="150"
                    HorizontalAlignment="Right"
                    Command="{Binding MostrarConfiguracionAvanzadaCommand}"/>

        </Grid>
        <!--#endregion-->
        
        
        <!--#region Panel de Categorias y Productos -->
        <Grid Grid.Row="1" Margin="20,10,20,10">
            
            
            <!--Estructura-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            
            <!--#region Categorias -->
            <Border Grid.Column="0" Background="{StaticResource Blanco}" BorderBrush="Gray" BorderThickness="2" CornerRadius="10">

                <Grid>

                    <Grid>

                        <Grid.Style>

                            <Style TargetType="Grid">

                                <Setter Property="Visibility" Value="Visible"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding FormularioCategoria}" Value="True">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                    </DataTrigger>
                                    
                                </Style.Triggers>

                            </Style>
                            
                            
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="55"/>
                        </Grid.RowDefinitions>


                        <!--Titulo-->
                        <Border Grid.Row="0" Height="50" Width="170" HorizontalAlignment="Left" Margin="15,0,0,0" Background="{StaticResource Naranja 70%}" CornerRadius="5">

                            <TextBlock Text="CATEGORIAS"
                                   FontFamily="{StaticResource Fuente-principal}"
                                   FontSize="24" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>


                        <!--Lista-->
                        <ListBox Grid.Row="1" Style="{StaticResource ListaCategorias}" ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSeleccionada}" />


                        <!--Boton-->
                        <Button Grid.Row="2" Style="{StaticResource BtnCatyPro}" 
                            Width="auto" Margin="10,0,10,10"
                            Command="{Binding MostrarFormularioCategoriaCommand}">

                            <StackPanel Orientation="Horizontal">


                                <!--Imagen-->
                                <Image Source="/Assets/Imagenes/Icono_de_Adicion.png" Height="30" Stretch="Uniform"/>


                                <!--Texto-->
                                <TextBlock Grid.Column="1" Text="Añadir nueva categoria"
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="18" FontWeight="SemiBold"
                                       Margin="15,0,0,0"
                                       VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </Grid>



                    <!--#region Formulario de categoria-->
                    <Grid Grid.RowSpan="3">

                        <Grid.Style>

                            <Style TargetType="Grid">

                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding FormularioCategoria}" Value="True">

                                        <Setter Property="Visibility" Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Grid.Style>

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            
                            <!-- Texto (NUEVA CATEGORIA) -->
                            <TextBlock Grid.Row="0" Text="NUEVA CATEGORIA" 
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="28" FontWeight="SemiBold"
                                       Margin="0,5,0,20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">

                                <TextBlock.Style>

                                    <Style TargetType="TextBlock">

                                        <Setter Property="Visibility" Value="Visible"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding ModoEdicionCategoria}" Value="True">

                                                <Setter Property="Visibility" Value="Collapsed"/>

                                            </DataTrigger>


                                        </Style.Triggers>

                                    </Style>
                                    
                                </TextBlock.Style>

                            </TextBlock>
                            
                            
                            <!-- Texto (EDITAR CATEGORIA) -->
                            <TextBlock Grid.Row="0" Text="EDITAR CATEGORIA" 
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="28" FontWeight="SemiBold"
                                       Margin="0,5,0,20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">

                                <TextBlock.Style>

                                    <Style TargetType="TextBlock">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding ModoEdicionCategoria}" Value="True">

                                                <Setter Property="Visibility" Value="Visible"/>

                                            </DataTrigger>


                                        </Style.Triggers>

                                    </Style>

                                </TextBlock.Style>

                            </TextBlock>
                            
                            
                            <!--Nombre de la categoria-->
                            <TextBlock Grid.Row="1" Text="Nombre de la categoria"
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="22" FontWeight="SemiBold"
                                       Margin="0,5,0,10"
                                       HorizontalAlignment="Center"/>

                            <TextBox Grid.Row="2" Text="{Binding NombreCategoria,UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource Fuente-principal}"
                                     FontSize="19"
                                     Height="40" Width="300"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            
                            
                            <!--Botones-->
                            <StackPanel Grid.Row="3" Orientation="Horizontal">

                                <Button Content="CANCELAR" Style="{StaticResource BtnComentario}"
                                        FontFamily="{StaticResource Fuente-principal}"
                                        FontSize="18"
                                        Margin="0,0,10,0"
                                        Height="40" Width="130"
                                        Command="{Binding CancelarFormularioCommand}"/>

                                <Button Content="GUARDAR" Style="{StaticResource BtnGuardarCambios}"
                                        FontFamily="{StaticResource Fuente-principal}"
                                        FontSize="18"
                                        Height="40" Width="130"
                                        Command="{Binding GuardarCategoriaCommand}"/>


                            </StackPanel>

                        </Grid>

                    </Grid>
                    <!--#endregion-->
                    

                </Grid>

            </Border>
            <!--#endregion-->
            
            
            <!--#region Productos-->
            <Border Grid.Column="2" Background="{StaticResource Blanco}" BorderBrush="Gray" BorderThickness="2" CornerRadius="10">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="55"/>
                    </Grid.RowDefinitions>


                    <!--Titulo-->
                    <Border Grid.Row="0" Height="50" Width="170" HorizontalAlignment="Left" Margin="15,0,0,0" Background="{StaticResource Naranja 70%}" CornerRadius="5">

                        <TextBlock Text="PRODUCTOS"
                                   FontFamily="{StaticResource Fuente-principal}"
                                   FontSize="24" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </Border>
                    
                    
                    <!--Lista-->
                    <Grid Grid.Row="1">

                        <Grid.Style>

                            <Style TargetType="Grid">

                                <Setter Property="Visibility" Value="Visible"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding FormularioProducto}" Value="True">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                    </DataTrigger>
                                    
                                </Style.Triggers>

                            </Style>
                            
                        </Grid.Style>
                        
                        <ListBox Style="{StaticResource ListaProductos}" ItemsSource="{Binding ProductosCategoriaSeleccionada }" SelectedItem="{Binding ProductoSeleccionado}"/>


                        <!--Estado Vacio-->
                        <TextBlock Grid.Row="1" Text="Da clic a una categoría&#x0a;o añade una para empezar"
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="38" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock">

                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding TieneCategoriaSeleccionada}" Value="False">

                                            <Setter Property="Visibility" Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>


                        <TextBlock Grid.Row="1" Text="Esta categoria no tiene productos registrados"
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="38" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock">

                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>

                                        <MultiDataTrigger>

                                            <MultiDataTrigger.Conditions>

                                                <Condition Binding="{Binding TieneCategoriaSeleccionada}" Value="True"/>

                                                <Condition Binding="{Binding TieneProductosCategoria}" Value="False"/>

                                            </MultiDataTrigger.Conditions>

                                            <Setter Property="Visibility" Value="Visible"/>

                                        </MultiDataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>
                        
                    </Grid>


                    <!--Boton-->
                    <Button Grid.Row="2"
                            Width="auto" Margin="10,0,10,10"
                            Command="{Binding MostrarFormularioProductoCommand}">

                        <Button.Style>

                            <Style TargetType="Button" BasedOn="{StaticResource BtnCatyPro}">

                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding TieneCategoriaSeleccionada}" Value="True">

                                        <Setter Property="Visibility" Value="Visible"/>

                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding FormularioProducto}" Value="True">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding FormularioCategoria}" Value="True">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                    </DataTrigger>
                                    
                                </Style.Triggers>

                            </Style>
                            
                        </Button.Style>

                        <StackPanel Orientation="Horizontal">


                            <!--Imagen-->
                            <Image Source="/Assets/Imagenes/Icono_de_Adicion.png" Height="30" Stretch="Uniform"/>


                            <!--Texto-->
                            <TextBlock Grid.Column="1" Text="Añadir nuevo producto"
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="18" FontWeight="SemiBold"
                                       Margin="15,0,0,0"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <!--#region Formulario de producto-->
                    <Grid Grid.Row="1">

                        <Grid.Style>

                            <Style TargetType="Grid">

                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding FormularioProducto}" Value="True">

                                        <Setter Property="Visibility" Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Grid.Style>


                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>


                            <!--Título-->
                            <TextBlock Grid.Row="0" Text="NUEVO PRODUCTO"
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="28" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            
                            <!--Nombre-->
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,15">

                                <TextBlock Text="Nombre del producto"
                                           FontFamily="{StaticResource Fuente-principal}"
                                           FontSize="20" FontWeight="SemiBold"
                                           Margin="0,0,0,8"
                                           HorizontalAlignment="Center"/>

                                <TextBox Text="{Binding NombreProducto, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource Fuente-principal}"
                                         FontSize="18"
                                         Height="40" Width="300"/>

                            </StackPanel>


                            <!--Precio-->
                            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,20">

                                <TextBlock Text="Precio"
                                           FontFamily="{StaticResource Fuente-principal}"
                                           FontSize="20" FontWeight="SemiBold"
                                           Margin="0,0,0,8"
                                           HorizontalAlignment="Center"/>

                                <TextBox Text="{Binding PrecioProducto, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource Fuente-principal}"
                                         FontSize="18"
                                         Height="40" Width="300"/>

                            </StackPanel>


                            <!--Botones-->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                                <Button Content="CANCELAR" Style="{StaticResource BtnComentario}"
                                        FontFamily="{StaticResource Fuente-principal}"
                                        FontSize="18"
                                        Height="40" Width="130"
                                        Margin="0,0,10,0"
                                        Command="{Binding CancelarFormularioCommand}"/>

                                <Button Content="GUARDAR" Style="{StaticResource BtnGuardarCambios}"
                                        FontFamily="{StaticResource Fuente-principal}"
                                        FontSize="18"
                                        Height="40" Width="130"
                                        Command="{Binding GuardarProductoCommand}"/>

                            </StackPanel>

                        </Grid>

                    </Grid>
                    <!--#endregion-->

                </Grid>

            </Border>
            <!--#endregion-->
            
            
            <!--#region Extra / Modificadores-->
            <Border Grid.Column="4" Background="{StaticResource Blanco}" BorderBrush="Gray" BorderThickness="2" CornerRadius="10">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="55"/>
                    </Grid.RowDefinitions>


                    <!--Titulo-->
                    <Border Grid.Row="0" Height="50" Width="170" HorizontalAlignment="Left" Margin="15,0,0,0" Background="{StaticResource Naranja 70%}" CornerRadius="5">

                        <TextBlock Text="EXTRAS / MODIFICADORES"
                                   FontFamily="{StaticResource Fuente-principal}"
                                   FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </Border>
                    
                    
                    <!--Estado vacio-->
                    <TextBlock Grid.Row="1" Text="Da clic a una categoria&#x0a;o añade una para empezar"
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="38" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    
                                    
                                    <!--Sin categoria-->
                                    <DataTrigger Binding="{Binding TieneCategoriaSeleccionada}" Value="False">

                                        <Setter Property="Visibility" Value="Visible"/>

                                    </DataTrigger>
                                    
                                    
                                    <!--Formulario abierto-->
                                    <DataTrigger Binding="{Binding FormularioExtra}" Value="True">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                    </DataTrigger>
                                    
                                </Style.Triggers>

                            </Style>
                            
                        </TextBlock.Style>

                    </TextBlock>
                    
                    
                    <!--Lista de Extras / Modificadores-->
                    <ListBox Grid.Row="1" ItemsSource="{Binding ExtrasCategoriaSeleccionada}" SelectedItem="{Binding ExtraSeleccionado}" >

                        <ListBox.Style>

                            <Style TargetType="ListBox" BasedOn="{StaticResource ListaProductos}">

                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding TieneExtrasCategoria}" Value="True">

                                        <Setter Property="Visibility" Value="Visible"/>

                                    </DataTrigger>

                                    
                                    <!--Formulario abierto-->
                                    <DataTrigger Binding="{Binding FormularioExtra}" Value="True">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                    </DataTrigger>
                                    
                                </Style.Triggers>

                            </Style>
                            
                        </ListBox.Style>
                        
                    </ListBox>
                    
                    
                    <!--Estado: Categoria sin Extras-->
                    <TextBlock Grid.Row="1" Text="Esta categoria no tiene Extras/Modificadores registrados."
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="38" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>

                                    <MultiDataTrigger>

                                        <MultiDataTrigger.Conditions>

                                            <Condition Binding="{Binding TieneCategoriaSeleccionada}" Value="True"/>

                                            <Condition Binding="{Binding TieneExtrasCategoria}" Value="False"/>

                                        </MultiDataTrigger.Conditions>

                                        <Setter Property="Visibility" Value="Visible"/>

                                    </MultiDataTrigger>
                                    
                                    
                                    <!--Formulario abierto-->
                                    <DataTrigger Binding="{Binding FormularioExtra}" Value="True">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                    </DataTrigger>
                                    
                                </Style.Triggers>

                            </Style>
                            
                        </TextBlock.Style>
                        
                        
                    </TextBlock>


                    <!--Boton-->
                    <Button Grid.Row="2"
                            Width="auto" Margin="10,0,10,10"
                            Command="{Binding MostrarFormularioExtraCommand}">

                        <Button.Style>

                            <Style TargetType="Button" BasedOn="{StaticResource BtnCatyPro}">

                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding TieneCategoriaSeleccionada}" Value="True">

                                        <Setter Property="Visibility" Value="Visible"/>

                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding FormularioProducto}" Value="True">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding FormularioCategoria}" Value="True">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding FormularioExtra}" Value="True">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                    </DataTrigger>
                                    

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                        <StackPanel Orientation="Horizontal">


                            <!--Imagen-->
                            <Image Source="/Assets/Imagenes/Icono_de_Adicion.png" Height="30" Stretch="Uniform"/>


                            <!--Texto-->
                            <TextBlock Grid.Column="1" Text="Añadir nuevo extra/modificador"
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="18" FontWeight="SemiBold"
                                       Margin="15,0,0,0"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>
                    
                    
                    <!--Formulario Extra/Modificador-->
                    <Grid Grid.Row="1" Margin="10,50,10,0">
                        
                        <Grid.Style>

                            <Style TargetType="Grid">

                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding FormularioExtra}" Value="True">

                                        <Setter Property="Visibility" Value="Visible"/>

                                    </DataTrigger>
                                    
                                </Style.Triggers>

                            </Style>
                            
                        </Grid.Style> 

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            
                            <!-- Título -->
                            <TextBlock Grid.Row="0" Text="NUEVO EXTRA"
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="28" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            
                            <!-- Nombre -->
                            <StackPanel Grid.Row="1" >

                                <TextBlock Text="Nombre del extra"
                                           FontFamily="{StaticResource Fuente-principal}"
                                           FontSize="20" FontWeight="SemiBold"
                                           Margin="0,25,0,0"/>

                                <TextBox Text="{Binding NombreExtra, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource Fuente-principal}"
                                         FontSize="18"
                                         Height="40"/>

                            </StackPanel>

                            
                            <!-- Precio -->
                            <StackPanel Grid.Row="2">

                                <TextBlock Text="Precio adicional ($)"
                                           FontFamily="{StaticResource Fuente-principal}"
                                           FontSize="20" FontWeight="SemiBold"
                                           Margin="0,25,0,3"/>

                                <TextBlock Text="* Coloca $0 si es un modificador sin costo (ej. Sin cebolla)   "
                                           FontFamily="{StaticResource Fuente-principal}"
                                           FontSize="11" Foreground="Gray" FontStyle="Italic" FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>

                                <TextBox Text="{Binding PrecioExtra, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource Fuente-principal}"
                                         FontSize="18"
                                         Height="40"/>

                            </StackPanel>

                            
                            <!-- Botones -->
                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,50,0,0" >

                                <Button Content="Cancelar" Style="{StaticResource BtnComentario}"
                                        FontFamily="{StaticResource Fuente-principal}"
                                        FontSize="18"
                                        Width="130" Height="40"
                                        Margin="0,0,20,0"
                                        Command="{Binding CancelarFormularioCommand}"/>

                                <Button Content="Guardar" Style="{StaticResource BtnGuardarCambios}"
                                        FontFamily="{StaticResource Fuente-principal}"
                                        FontSize="18"
                                        Width="130" Height="40"
                                        Command="{Binding GuardarExtraCommand}"/>

                            </StackPanel>

                            
                        </Grid>


                    </Grid>


                </Grid>

            </Border>
            <!--#endregion-->
            

            
        </Grid>
        <!--#endregion-->

        <!--#region MODAL PIN OVERLAY (Teclado Numérico Táctil)-->
        <Grid Grid.RowSpan="2" Background="#A6000000" Visibility="{Binding MostrarModalPin, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="380" Background="White" CornerRadius="16" BorderBrush="Black" BorderThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Encabezado -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="🔒 AUTORIZACIÓN" FontFamily="{StaticResource Fuente-principal}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ingrese PIN de administrador" FontFamily="{StaticResource Fuente-principal}" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Visor de PIN enmascarado -->
                    <Border Grid.Row="1" Height="50" Background="#F5F5F5" BorderBrush="Black" BorderThickness="2" CornerRadius="8" Margin="0,0,0,6">
                        <TextBlock Text="{Binding PinEnmascarado}" FontFamily="{StaticResource Fuente-principal}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#212121" Margin="10,0"/>
                    </Border>

                    <!-- Mensaje de error -->
                    <TextBlock Grid.Row="2" Text="{Binding MensajeErrorPin}" FontFamily="{StaticResource Fuente-principal}" FontSize="13" Foreground="Red" HorizontalAlignment="Center" Margin="0,0,0,8" Height="18" TextTrimming="CharacterEllipsis"/>

                    <!-- Teclado Numérico Táctil -->
                    <UniformGrid Grid.Row="3" Rows="4" Columns="3" Margin="0,0,0,15">
                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="1" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="1"/>
                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="2" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="2"/>
                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="3" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="3"/>

                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="4" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="4"/>
                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="5" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="5"/>
                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="6" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="6"/>

                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="7" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="7"/>
                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="8" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="8"/>
                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="9" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="9"/>

                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="22" FontWeight="Bold" Foreground="#C62828" Content="C" Command="{Binding LimpiarPinCommand}"/>
                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="0" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="0"/>
                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" Command="{Binding BorrarDigitoPinCommand}">
                            <Image Source="/Assets/Imagenes/Icono_eliminacion_teclado.png" Height="26" Width="26" Stretch="Uniform"/>
                        </Button>
                    </UniformGrid>

                    <!-- Botones de Acción Modal -->
                    <Button Grid.Row="4" Command="{Binding ConfirmarPinCommand}" Style="{StaticResource BtnGuardarCambios}" Height="45" Margin="6,0,0,0" FontFamily="{StaticResource Fuente-principal}" FontSize="16" FontWeight="Bold" Content="CONFIRMAR"/>

                </Grid>
            </Border>
        </Grid>
        <!--#endregion-->


    </Grid>

</UserControl>