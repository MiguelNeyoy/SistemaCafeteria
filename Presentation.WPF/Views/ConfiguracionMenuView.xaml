<UserControl x:Class="Presentation.WPF.Views.ConfiguracionMenuViewModel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Presentation.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">

    <Grid>


        <!--Estrutura-->
        <Grid.RowDefinitions>
            <RowDefinition Height="160"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!--#region Tarjeta de productos -->
        <Border Grid.Row="0" Width="300" Height="150" HorizontalAlignment="Left" Margin="20,0,0,0" Background="{StaticResource Blanco}" CornerRadius="10" BorderThickness="2" BorderBrush="Black">

            <Grid Margin="10,5,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!--Texto-->
                <TextBlock Grid.Row="0" Text="Total productos:"
                           FontFamily="{StaticResource Fuente-principal}"
                           FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>


                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>


                    <!--Imagen-->
                    <Image Source="/Assets/Imagenes/Icono_de_alimento.png" Stretch="Uniform"/>


                    <!--Texto-->
                    <TextBlock Grid.Column="1" Text="{Binding TotalProductos}"
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="26" FontWeight="SemiBold"
                               Margin="15,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>

            </Grid>

        </Border>
        <!--#endregion-->
        
        
        <!--#region Panel de Categorias y Productos -->
        <Grid Grid.Row="1" Margin="20,10,20,10">
            
            
            <!--Estructura-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            
            <!--#region Categorias -->
            <Border Grid.Column="0" Background="{StaticResource Blanco}" BorderBrush="Gray" BorderThickness="2" CornerRadius="10">

                <Grid>

                    <Grid>

                        <Grid.Style>

                            <Style TargetType="Grid">

                                <Setter Property="Visibility" Value="Visible"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding FormularioCategoria}" Value="True">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                    </DataTrigger>
                                    
                                </Style.Triggers>

                            </Style>
                            
                            
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="55"/>
                        </Grid.RowDefinitions>


                        <!--Titulo-->
                        <Border Grid.Row="0" Height="50" Width="170" HorizontalAlignment="Left" Margin="15,0,0,0" Background="{StaticResource Naranja 70%}" CornerRadius="5">

                            <TextBlock Text="CATEGORIAS"
                                   FontFamily="{StaticResource Fuente-principal}"
                                   FontSize="24" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>


                        <!--Lista-->
                        <ListBox Grid.Row="1" Style="{StaticResource ListaCategorias}" ItemsSource="{Binding Categorias}" SelectedItem="{Binding CategoriaSeleccionada}" />


                        <!--Boton-->
                        <Button Grid.Row="2" Style="{StaticResource BtnCatyPro}" 
                            Width="420" Margin="0,0,0,5"
                            Command="{Binding MostrarFormularioCategoriaCommand}">

                            <StackPanel Orientation="Horizontal">


                                <!--Imagen-->
                                <Image Source="/Assets/Imagenes/Icono_de_Adicion.png" Height="30" Stretch="Uniform"/>


                                <!--Texto-->
                                <TextBlock Grid.Column="1" Text="Añadir nueva categoria"
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="18" FontWeight="SemiBold"
                                       Margin="15,0,0,0"
                                       VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </Grid>



                    <!--#region Formulario de categoria-->
                    <Grid Grid.RowSpan="3">

                        <Grid.Style>

                            <Style TargetType="Grid">

                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding FormularioCategoria}" Value="True">

                                        <Setter Property="Visibility" Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Grid.Style>

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            
                            <!-- Texto (NUEVA CATEGORIA) -->
                            <TextBlock Grid.Row="0" Text="NUEVA CATEGORIA" 
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="28" FontWeight="SemiBold"
                                       Margin="0,5,0,20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">

                                <TextBlock.Style>

                                    <Style TargetType="TextBlock">

                                        <Setter Property="Visibility" Value="Visible"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding ModoEdicionCategoria}" Value="True">

                                                <Setter Property="Visibility" Value="Collapsed"/>

                                            </DataTrigger>


                                        </Style.Triggers>

                                    </Style>
                                    
                                </TextBlock.Style>

                            </TextBlock>
                            
                            
                            <!-- Texto (EDITAR CATEGORIA) -->
                            <TextBlock Grid.Row="0" Text="EDITAR CATEGORIA" 
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="28" FontWeight="SemiBold"
                                       Margin="0,5,0,20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">

                                <TextBlock.Style>

                                    <Style TargetType="TextBlock">

                                        <Setter Property="Visibility" Value="Collapsed"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding ModoEdicionCategoria}" Value="True">

                                                <Setter Property="Visibility" Value="Visible"/>

                                            </DataTrigger>


                                        </Style.Triggers>

                                    </Style>

                                </TextBlock.Style>

                            </TextBlock>
                            
                            
                            <!--Nombre de la categoria-->
                            <TextBlock Grid.Row="1" Text="Nombre de la categoria"
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="22" FontWeight="SemiBold"
                                       Margin="0,5,0,10"
                                       HorizontalAlignment="Center"/>

                            <TextBox Grid.Row="2" Text="{Binding NombreCategoria,UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource Fuente-principal}"
                                     FontSize="19"
                                     Height="40" Width="300"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            
                            
                            <!--Botones-->
                            <StackPanel Grid.Row="3">

                                <Button Content="CANCELAR" Style="{StaticResource BtnComentario}"
                                        FontFamily="{StaticResource Fuente-principal}"
                                        FontSize="18"
                                        Margin="0,0,10,0"
                                        Height="40" Width="130"
                                        Command="{Binding CancelarFormularioCommand}"/>

                                <Button Content="GUARDAR" Style="{StaticResource BtnGuardarCambios}"
                                        FontFamily="{StaticResource Fuente-principal}"
                                        FontSize="18"
                                        Height="40" Width="130"
                                        Command="{Binding GuardarCategoriaCommand}"/>


                            </StackPanel>

                        </Grid>

                    </Grid>
                    <!--#endregion-->
                    

                </Grid>

            </Border>
            <!--#endregion-->
            
            
            <!--#region Productos-->
            <Border Grid.Column="2" Background="{StaticResource Blanco}" BorderBrush="Gray" BorderThickness="2" CornerRadius="10">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="55"/>
                    </Grid.RowDefinitions>


                    <!--Titulo-->
                    <Border Grid.Row="0" Height="50" Width="170" HorizontalAlignment="Left" Margin="15,0,0,0" Background="{StaticResource Naranja 70%}" CornerRadius="5">

                        <TextBlock Text="PRODUCTOS"
                                   FontFamily="{StaticResource Fuente-principal}"
                                   FontSize="24" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </Border>
                    
                    
                    <!--Lista-->
                    <ListBox Grid.Row="1" Style="{StaticResource ListaProductos}" ItemsSource="{Binding ProductosCategoriaSeleccionada }" SelectedItem="{Binding ProductoSeleccionado}"/>
                    
                    
                    <!--Estado Vacio-->
                    <TextBlock Grid.Row="1" Text="Da clic a una categoría&#x0a;o añade una para empezar"
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="38" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding TieneCategoriaSeleccionada}" Value="False">

                                        <Setter Property="Visibility" Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>


                    <TextBlock Grid.Row="1" Text="Esta categoria no tiene productos registrados"
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="38" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>

                                    <MultiDataTrigger>

                                        <MultiDataTrigger.Conditions>

                                            <Condition Binding="{Binding TieneCategoriaSeleccionada}" Value="True"/>

                                            <Condition Binding="{Binding TieneProductosCategoria}" Value="False"/>

                                        </MultiDataTrigger.Conditions>

                                        <Setter Property="Visibility" Value="Visible"/>

                                    </MultiDataTrigger>

                                </Style.Triggers>

                            </Style>
                                
                        </TextBlock.Style>

                    </TextBlock>


                    <!--Boton-->
                    <Button Grid.Row="2" Style="{StaticResource BtnCatyPro}" Width="420" Margin="0,0,0,5"
                            Command="{Binding MostrarFormularioProductoCommand}">

                        <StackPanel Orientation="Horizontal">


                            <!--Imagen-->
                            <Image Source="/Assets/Imagenes/Icono_de_Adicion.png" Height="30" Stretch="Uniform"/>


                            <!--Texto-->
                            <TextBlock Grid.Column="1" Text="Añadir nuevo producto"
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="18" FontWeight="SemiBold"
                                       Margin="15,0,0,0"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </Grid>

            </Border>
            <!--#endregion-->

            
        </Grid>
        <!--#endregion-->


    </Grid>

</UserControl>