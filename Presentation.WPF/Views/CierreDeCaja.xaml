<UserControl x:Class="Presentation.WPF.Views.CierreDeCaja"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Presentation.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="900">
    <Grid>


        <!--#region Estructura Inicial-->
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <!--#endregion-->


        <!--Titulo-->
        <TextBlock Grid.Row="0" Text="CORTE DE CAJA"
                   FontFamily="{StaticResource Fuente-principal}"
                   FontSize="36" FontWeight="SemiBold"
                   Margin="0,15,0,15"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <!--#region Interfaz Visual-->
        <Border Grid.Row="1" Background="{StaticResource Blanco 70%}" BorderBrush="{StaticResource Gris}" Margin="100,20" BorderThickness="2" CornerRadius="15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <!--#region Resumen del Corte-->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20,0,15">

                    <TextBlock Text="RESUMEN DEL CORTE"
                           FontFamily="{StaticResource Fuente-principal}"
                           FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Gris}"
                           HorizontalAlignment="Center"/>

                    <TextBlock Text="TOTAL DE VENTAS"
                           FontFamily="{StaticResource Fuente-principal}"
                           FontSize="24" FontWeight="Bold"
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding TotalVentas, StringFormat={}{0:C}}"
                           FontFamily="{StaticResource Fuente-principal}"
                           FontSize="32" FontWeight="Bold"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"/>

                </StackPanel>
                <!--#endregion-->

                <Border Grid.Row="1" Padding="30" BorderBrush="{StaticResource Gris 50%}" BorderThickness="4" CornerRadius="10" HorizontalAlignment="Center">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        
                        <TextBlock Text="DESGLOCE POR METODO DE PAGO"
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="28" FontWeight="Bold"/>

                        
                        <Grid Grid.Row="1" Margin="0,20,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Background="{StaticResource Naranja 50%}" BorderBrush="{StaticResource Gris 50%}" BorderThickness="2" Margin="5" Padding="5" CornerRadius="8">

                                <StackPanel HorizontalAlignment="Center">

                                    <TextBlock Text="Efectivo"
                                               FontFamily="{StaticResource Fuente-principal}"
                                               FontSize="24" FontWeight="SemiBold"/>
                                    
                                    <TextBlock Text="{Binding TotalEfectivo, StringFormat={}{0:C}}"
                                               FontFamily="{StaticResource Fuente-principal}"
                                               FontSize="22" FontWeight="SemiBold"
                                               Margin="5"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>
                            
                             </Border>

                            <Border Grid.Column="1" Background="{StaticResource Naranja 50%}" BorderBrush="{StaticResource Gris 50%}" BorderThickness="2" Margin="5" Padding="5" CornerRadius="8">

                                <StackPanel HorizontalAlignment="Center">

                                    <TextBlock Text="Transferencia"
                                               FontFamily="{StaticResource Fuente-principal}"
                                               FontSize="24" FontWeight="SemiBold"/>

                                    <TextBlock Text="{Binding TotalTransferencia, StringFormat={}{0:C}}"
                                               FontFamily="{StaticResource Fuente-principal}"
                                               FontSize="22" FontWeight="SemiBold"
                                               Margin="5"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource Naranja 50%}" BorderBrush="{StaticResource Gris 50%}" BorderThickness="2" Margin="5" Padding="5" CornerRadius="8">

                                <StackPanel HorizontalAlignment="Center">

                                    <TextBlock Text="Tarjeta"
                                               FontFamily="{StaticResource Fuente-principal}"
                                               FontSize="24" FontWeight="SemiBold"/>

                                    <TextBlock Text="{Binding TotalTarjeta, StringFormat={}{0:C}}"
                                               FontFamily="{StaticResource Fuente-principal}"
                                               FontSize="22" FontWeight="SemiBold"
                                               Margin="5"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Border>
                            
                        </Grid>

                    </Grid>

                </Border>
                
                
                <!--#region Resumen Final-->
                <Border Grid.Row="2" Padding="30" Margin="0,40,0,20" BorderBrush="{StaticResource Gris 50%}" BorderThickness="4" CornerRadius="10" HorizontalAlignment="Center">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="RESUMEN FINAL"
                                   FontFamily="{StaticResource Fuente-principal}"
                                   FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <Grid Grid.Row="1" Margin="0,15,0,0">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal">

                                <TextBlock Text="Total de ventas"
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="24"/>

                                <TextBlock Text="{Binding TotalVentasBruto, StringFormat={}{0:C}}"
                                           FontFamily="{StaticResource Fuente-principal}"
                                           FontSize="20"
                                           Margin="50,0,0,0"/>

                            </StackPanel>


                            <StackPanel Grid.Row="1" Orientation="Horizontal">

                                <TextBlock Text="Total descuentos"
                                           FontFamily="{StaticResource Fuente-principal}"
                                           FontSize="24"/>

                                <TextBlock Text="{Binding TotalDescuentos, StringFormat={}{0:C}}"
                                           FontFamily="{StaticResource Fuente-principal}"
                                           FontSize="20"
                                           Margin="50,0,0,0"/>

                            </StackPanel>


                            <StackPanel Grid.Row="2" Orientation="Horizontal">

                                <TextBlock Text="Total neto"
                                           FontFamily="{StaticResource Fuente-principal}"
                                           FontSize="24"/>

                                <TextBlock Text="{Binding TotalNeto, StringFormat={}{0:C}}"
                                           FontFamily="{StaticResource Fuente-principal}"
                                           FontSize="20"
                                           Margin="50,0,0,0"/>

                            </StackPanel>
                            
                        </Grid>

                    </Grid>

                </Border>
                <!--#endregion-->
                
                

            </Grid>

        </Border>
        <!--#endregion-->

        <Button Grid.Row="2" Content="Cerrar caja" Style="{StaticResource BtnGuardarCambios}"
                FontFamily="{StaticResource Fuente-principal}"
                FontSize="20" FontWeight="Bold"
                Height="60" Width="200"
                Margin="0,10,100,25"
                HorizontalAlignment="Right"
                Command="{Binding CerrarCajaCommand}"/>

    </Grid>
</UserControl>