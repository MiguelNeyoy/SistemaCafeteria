<UserControl x:Class="Presentation.WPF.Views.CuentasAbiertasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Presentation.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="1024" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Estilo de Botón Rojo para Cancelar Cuenta -->
        <Style x:Key="BtnCancelarCuenta" TargetType="Button">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource Fuente-principal}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="15,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B71C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#8E0000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Botón Primario para Cobrar -->
        <Style x:Key="BtnCobrarCuenta" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Naranja}"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontFamily" Value="{StaticResource Fuente-principal}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="15,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFB300"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFA000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Botón Secundario (Actualizar) -->
        <Style x:Key="BtnRefrescar" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontFamily" Value="{StaticResource Fuente-principal}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EEEEEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource Amarillo claro_bajo}">
        <!--#region Estructura Principal -->
        <Grid.RowDefinitions>
            <RowDefinition Height="85"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--#endregion-->

        <!--#region Barra Superior -->
        <Border Grid.Row="0" Background="{StaticResource Amarillo claro_fuerte}" BorderBrush="#BDBDBD" BorderThickness="0,0,0,2">
            <Grid Margin="25,0,25,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Título y Métricas Rápidas -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cuentas Abiertas"
                                   FontFamily="{StaticResource Fuente-principal}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#212121"/>

                        <!-- Chip de Conteo -->
                        <Border Background="#E8F5E9" CornerRadius="12" Padding="10,3" Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalCuentas, StringFormat='{}{0} activas'}"
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#2E7D32"/>
                        </Border>

                        <!-- Chip de Monto Total -->
                        <Border Background="{StaticResource Naranja claro}" CornerRadius="12" Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MontoTotalAcumulado, StringFormat='{}Total: {0:C}'}"
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#8D6E63"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Selecciona una cuenta para visualizar su consumo o gestionarla"
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="14"
                               Foreground="#757575"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Botón de Actualización Manual -->
                <Button Grid.Column="1"
                        Style="{StaticResource BtnRefrescar}"
                        Command="{Binding CargarCuentasCommand}"
                        VerticalAlignment="Center"
                        Height="46">
                    <TextBlock Text="Actualizar" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>
        <!--#endregion-->

        <!--#region Cuerpo Master-Detail -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--#region PANEL IZQUIERDO: LISTA DE CUENTAS (MASTER) -->
            <Border Grid.Column="0" Background="{StaticResource Amarillo claro_fuerte}" BorderBrush="#BDBDBD" BorderThickness="0,0,2,0">
                <Grid>
                    <!-- Estado vacío cuando no hay cuentas -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TieneCuentas}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="No hay cuentas abiertas" 
                                   FontFamily="{StaticResource Fuente-principal}"
                                   FontSize="20" FontWeight="Bold" 
                                   Foreground="#616161" HorizontalAlignment="Center"/>
                        <TextBlock Text="Cuando se creen órdenes en la comanda aparecerán listadas aquí." 
                                   FontFamily="{StaticResource Fuente-principal}"
                                   FontSize="14" Foreground="#9E9E9E" 
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Lista de tarjetas de cuentas -->
                    <ListBox ItemsSource="{Binding Cuentas}"
                             SelectedItem="{Binding CuentaSeleccionada, Mode=TwoWay}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Padding="10">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource EstiloListBoxLimpio}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TieneCuentas}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        Margin="4,5"
                                        Padding="14,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Fila 1: Indicador de estado, Ticket y Tiempo -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="10" Height="10" Fill="#43A047" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Id, StringFormat='Ticket #{0}'}"
                                                           FontFamily="{StaticResource Fuente-principal}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="#616161"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TiempoTranscurrido}"
                                                       FontFamily="{StaticResource Fuente-principal}"
                                                       FontSize="12"
                                                       Foreground="#9E9E9E"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Fila 2: Nombre del cliente / Identificador -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Cliente}"
                                                   FontFamily="{StaticResource Fuente-principal}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#212121"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,6"/>

                                        <!-- Fila 3: Cantidad de ítems y Total -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding TotalProductos, StringFormat='{}{0} productos'}"
                                                       FontFamily="{StaticResource Fuente-principal}"
                                                       FontSize="14"
                                                       Foreground="#757575"
                                                       VerticalAlignment="Bottom"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Total, StringFormat={}{0:C}}"
                                                       FontFamily="{StaticResource Fuente-principal}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="#E65100"
                                                       VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <!--#endregion-->

            <!--#region PANEL DERECHO: DETALLE DE LA CUENTA (DETAIL) -->
            <Grid Grid.Column="1" Background="{StaticResource Amarillo claro_bajo}">

                <!-- Mensaje cuando no hay cuenta seleccionada -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CuentaSeleccionada}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Selecciona una cuenta de la lista"
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="#757575" HorizontalAlignment="Center"/>
                    <TextBlock Text="Podrás consultar los productos consumidos, notas, extras y gestionar el cobro."
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="15" Foreground="#9E9E9E"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Detalle visible cuando se selecciona una cuenta -->
                <Grid Margin="20">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CuentaSeleccionada}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Encabezado del Detalle -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1.5" CornerRadius="10" Padding="20,16" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CuentaSeleccionada.Cliente}"
                                               FontFamily="{StaticResource Fuente-principal}"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Foreground="#212121"/>
                                    <Border Background="#E0F2F1" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CuentaSeleccionada.Id, StringFormat='Ticket #{0}'}"
                                                   FontFamily="{StaticResource Fuente-principal}"
                                                   FontSize="14" FontWeight="Bold" Foreground="#00796B"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Abierta: "
                                               FontFamily="{StaticResource Fuente-principal}"
                                               FontSize="14" Foreground="#757575"/>
                                    <TextBlock Text="{Binding CuentaSeleccionada.HoraCreacion}"
                                               FontFamily="{StaticResource Fuente-principal}"
                                               FontSize="14" FontWeight="SemiBold" Foreground="#424242"/>
                                    <TextBlock Text="  •  " Foreground="#BDBDBD" Margin="6,0"/>
                                    <TextBlock Text="{Binding CuentaSeleccionada.TiempoTranscurrido}"
                                               FontFamily="{StaticResource Fuente-principal}"
                                               FontSize="14" Foreground="#757575"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Estado Activo Badge -->
                            <Border Grid.Column="1" Background="#E8F5E9" CornerRadius="8" Padding="14,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#2E7D32" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Abierta"
                                               FontFamily="{StaticResource Fuente-principal}"
                                               FontSize="14" FontWeight="Bold" Foreground="#2E7D32"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Lista de Productos en la Cuenta -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1.5" CornerRadius="10" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Detalle de Consumo"
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="16" FontWeight="Bold" Foreground="#616161"
                                       Margin="5,0,0,10"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CuentaSeleccionada.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="10,12">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Línea Principal: Cantidad, Nombre y Precio -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Insignia de Cantidad -->
                                                        <Border Grid.Column="0" Background="{StaticResource Naranja claro}" CornerRadius="6" Width="34" Height="30" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Cantidad, StringFormat='{}{0}x'}"
                                                                       FontFamily="{StaticResource Fuente-principal}"
                                                                       FontSize="15" FontWeight="Bold"
                                                                       Foreground="#BF360C"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Nombre y Precio Unitario -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ProductoNombre}"
                                                                       FontFamily="{StaticResource Fuente-principal}"
                                                                       FontSize="18" FontWeight="SemiBold"
                                                                       Foreground="#212121"/>
                                                            <TextBlock Text="{Binding PrecioUnitario, StringFormat='{}{0:C} c/u'}"
                                                                       FontFamily="{StaticResource Fuente-principal}"
                                                                       FontSize="13" Foreground="#757575"/>
                                                        </StackPanel>

                                                        <!-- Subtotal del Producto -->
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Subtotal, StringFormat={}{0:C}}"
                                                                   FontFamily="{StaticResource Fuente-principal}"
                                                                   FontSize="18" FontWeight="Bold"
                                                                   Foreground="#212121"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <!-- Extras agregados -->
                                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Extras}" Margin="46,6,0,0">
                                                        <ItemsControl.Style>
                                                            <Style TargetType="ItemsControl">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TieneExtras}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ItemsControl.Style>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}"
                                                                           FontFamily="{StaticResource Fuente-principal}"
                                                                           FontSize="13"
                                                                           Foreground="#E65100"
                                                                           Margin="0,1"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Notas de cocina / preparación -->
                                                    <Border Grid.Row="2" Background="#FFF9C4" CornerRadius="4" Padding="8,4" Margin="46,6,0,0" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TieneNotas}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Notas, StringFormat='Nota: {0}'}"
                                                                   FontFamily="{StaticResource Fuente-principal}"
                                                                   FontSize="13"
                                                                   FontStyle="Italic"
                                                                   Foreground="#5D4037"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Totales Financieros -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1.5" CornerRadius="10" Padding="20,14" Margin="0,15,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Subtotal -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Subtotal" FontFamily="{StaticResource Fuente-principal}" FontSize="16" Foreground="#757575"/>
                                <TextBlock Grid.Column="1" Text="{Binding CuentaSeleccionada.Subtotal, StringFormat={}{0:C}}" FontFamily="{StaticResource Fuente-principal}" FontSize="16" Foreground="#424242"/>
                            </Grid>

                            <!-- Descuento (si existe) -->
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Descuento" FontFamily="{StaticResource Fuente-principal}" FontSize="15" Foreground="#388E3C"/>
                                <TextBlock Grid.Column="1" Text="{Binding CuentaSeleccionada.Descuento, StringFormat='-{0:C}'}" FontFamily="{StaticResource Fuente-principal}" FontSize="15" FontWeight="SemiBold" Foreground="#388E3C"/>
                            </Grid>

                            <!-- Total Final Destacado -->
                            <Border Grid.Row="2" BorderBrush="#EEEEEE" BorderThickness="0,1.5,0,0" Padding="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total de la Cuenta"
                                               FontFamily="{StaticResource Fuente-principal}"
                                               FontSize="24" FontWeight="Bold"
                                               Foreground="#212121"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CuentaSeleccionada.Total, StringFormat={}{0:C}}"
                                               FontFamily="{StaticResource Fuente-principal}"
                                               FontSize="30" FontWeight="Bold"
                                               Foreground="#E65100"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Acciones: Cancelar Cuenta y Cobrar -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Botón Cancelar Cuenta (Rojo explícito) -->
                        <Button Grid.Column="0"
                                Style="{StaticResource BtnCancelarCuenta}"
                                Command="{Binding CancelarCuentaCommand}"
                                Height="60">
                            <TextBlock Text="Cancelar Cuenta" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Botón Cobrar (Llamativo/Destacado con Naranja) -->
                        <Button Grid.Column="2"
                                Style="{StaticResource BtnCobrarCuenta}"
                                Command="{Binding CobrarCuentaCommand}"
                                Height="60">
                            <TextBlock Text="Cobrar Cuenta" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                </Grid>

            </Grid>
            <!--#endregion-->

        </Grid>
        <!--#endregion-->

    </Grid>

</UserControl>
