<Window x:Class="Presentation.WPF.Views.Alertas.AlertaVentana"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Estilo Botón Primario de Alerta -->
        <Style x:Key="BtnAlertaPrimario" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Naranja}"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontFamily" Value="{StaticResource Fuente-principal}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="18,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFB300"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFA000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Botón Secundario de Alerta -->
        <Style x:Key="BtnAlertaSecundario" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontFamily" Value="{StaticResource Fuente-principal}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10" Padding="16,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EEEEEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <!-- Tarjeta Principal con Sombra Suave -->
        <Border Width="450" MaxWidth="500" 
                Background="White" 
                CornerRadius="16" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1" 
                Padding="28,24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" Color="#000000" Opacity="0.32" ShadowDepth="5" Direction="270"/>
            </Border.Effect>

            <StackPanel HorizontalAlignment="Stretch">
                <!-- Insignia Circular con Icono -->
                <Border x:Name="BadgeIcono" 
                        Width="66" Height="66" 
                        CornerRadius="33" 
                        HorizontalAlignment="Center" 
                        Margin="0,0,0,14">
                    <TextBlock x:Name="TxtIcono" 
                               FontSize="32" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Título de la Alerta -->
                <TextBlock x:Name="TxtTitulo" 
                           FontFamily="{StaticResource Fuente-principal}" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="#212121" 
                           TextAlignment="Center" 
                           TextWrapping="Wrap" 
                           Margin="0,0,0,10"/>

                <!-- Mensaje de la Alerta -->
                <TextBlock x:Name="TxtMensaje" 
                           FontFamily="{StaticResource Fuente-principal}" 
                           FontSize="16" 
                           Foreground="#555555" 
                           TextAlignment="Center" 
                           LineHeight="22" 
                           LineStackingStrategy="BlockLineHeight" 
                           TextWrapping="Wrap" 
                           Margin="0,0,0,24"/>

                <!-- Panel de Botones de Acción -->
                <Grid x:Name="PanelBotones">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColCancelar" Width="*"/>
                        <ColumnDefinition x:Name="ColConfirmar" Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Botón Cancelar (solo si hay TextoCancelar) -->
                    <Button x:Name="BtnCancelar" 
                            Grid.Column="0" 
                            Style="{StaticResource BtnAlertaSecundario}" 
                            Margin="0,0,10,0" 
                            IsCancel="True" 
                            Click="BtnCancelar_Click"/>

                    <!-- Botón Confirmar / Aceptar -->
                    <Button x:Name="BtnConfirmar" 
                            Grid.Column="1" 
                            Style="{StaticResource BtnAlertaPrimario}" 
                            IsDefault="True" 
                            Click="BtnConfirmar_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
