<UserControl x:Class="Presentation.WPF.Views.ConfiguracionAvanzadaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Presentation.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid Margin="14,10,14,14">
        <Grid.RowDefinitions>
            <!-- Fila 0: Barra Superior de Navegacion -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: Tres Paneles Principales -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--#region Barra Superior -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" BorderBrush="#E0E0E0" BorderThickness="1.5" Padding="16,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Configuración Avanzada del Sistema"
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="22" FontWeight="Bold" Foreground="#212121"/>
                    <TextBlock Text="Gestión de seguridad administrativa, actualizaciones, purga de base de datos y periféricos"
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="12" Foreground="Gray" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Boton Volver al Inicio con estilo inline -->
                <Button Grid.Column="1" 
                        Command="{Binding RegresarCommand}"
                        Height="42" Padding="20,6"
                        Background="#F5F5F5"
                        BorderBrush="#BDBDBD"
                        BorderThickness="1.5"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="Volver al Inicio" 
                                           FontFamily="{StaticResource Fuente-principal}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#424242"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bdr" Property="Background" Value="#E0E0E0"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bdr" Property="Background" Value="#BDBDBD"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
        <!--#endregion-->

        <!--#region Contenido Principal en 3 Columnas -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--#region Columna 0: PIN de Administrador + Actualizaciones del Sistema -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <!-- Tarjeta Superior: PIN de Administrador -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <!-- Tarjeta Inferior: Actualizaciones del Sistema -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tarjeta 1: PIN de Administrador -->
                <Border Grid.Row="0" Background="{StaticResource Blanco}" CornerRadius="12" BorderThickness="1.5" BorderBrush="#BDBDBD" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="PIN de Administrador"
                                   FontFamily="{StaticResource Fuente-principal}"
                                   FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,10"/>

                        <Border Background="#F5F5F5" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                            <TextBlock Text="Actualice la clave maestra utilizada para autorizar operaciones sensibles."
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="11" Foreground="#616161" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="PIN Actual:"
                                   FontFamily="{StaticResource Fuente-principal}"
                                   FontSize="13" FontWeight="SemiBold"/>

                        <TextBox Text="{Binding PinActual, UpdateSourceTrigger=PropertyChanged}" 
                                 VerticalContentAlignment="Center"
                                 FontFamily="{StaticResource Fuente-principal}"
                                 FontSize="13"
                                 Margin="0,3,0,10" Padding="6,0"
                                 Height="32"/>

                        <TextBlock Text="Nuevo PIN (mínimo 4 dígitos):"
                                   FontFamily="{StaticResource Fuente-principal}"
                                   FontSize="13" FontWeight="SemiBold"/>

                        <TextBox Text="{Binding PinNuevo, UpdateSourceTrigger=PropertyChanged}" 
                                 VerticalAlignment="Center"
                                 FontFamily="{StaticResource Fuente-principal}"
                                 FontSize="13"
                                 Margin="0,3,0,10" Padding="6,0"
                                 Height="32"/>

                        <Button Content="Actualizar PIN" 
                                Style="{StaticResource BtnGuardarCambios}"
                                FontFamily="{StaticResource Fuente-principal}"
                                FontSize="15" FontWeight="SemiBold"
                                Height="38" Margin="0,4,0,4"
                                Command="{Binding CambiarPinCommand}"/>

                        <TextBlock Text="{Binding MensajeSeguridad}" 
                                   FontFamily="{StaticResource Fuente-principal}" 
                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EsMensajeSeguridadError}" Value="True">
                                            <Setter Property="Foreground" Value="#D32F2F"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 2: Actualizaciones del Sistema -->
                <Border Grid.Row="2" Background="{StaticResource Blanco}" CornerRadius="12" BorderThickness="1.5" BorderBrush="#81C784" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Encabezado con Version Actual -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Actualizaciones" 
                                       FontFamily="{StaticResource Fuente-principal}" 
                                       FontSize="17" FontWeight="Bold" 
                                       Foreground="#2E7D32" 
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#E8F5E9" BorderBrush="#81C784" BorderThickness="1.5" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="{Binding VersionActual, StringFormat='{}v{0}'}" 
                                           FontFamily="{StaticResource Fuente-principal}" 
                                           FontSize="12" FontWeight="Bold" 
                                           Foreground="#1B5E20"/>
                            </Border>
                        </Grid>

                        <!-- Estado / Mensaje en tiempo real -->
                        <Border Grid.Row="1" Background="#F1F8E9" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding MensajeActualizacion}" 
                                       FontFamily="{StaticResource Fuente-principal}" 
                                       FontSize="11" Foreground="#33691E" 
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Barra de Progreso interactiva -->
                        <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,4,0,10">
                            <ProgressBar Value="{Binding ProgresoActualizacion}" 
                                         Maximum="100" Height="10" 
                                         BorderThickness="0" 
                                         Background="#E0E0E0" 
                                         Foreground="#2E7D32"/>
                            <TextBlock Text="{Binding ProgresoActualizacion, StringFormat='{}{0}% completado'}" 
                                       FontFamily="{StaticResource Fuente-principal}" 
                                       FontSize="11" Foreground="#757575" 
                                       HorizontalAlignment="Right" 
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Botones de Accion de Actualizacion -->
                        <Grid Grid.Row="3">
                            <!-- Botón Buscar Actualizaciones (Visible cuando no está lista) -->
                            <Button Command="{Binding BuscarActualizacionesCommand}" 
                                    Height="40" 
                                    Background="#2E7D32" 
                                    BorderBrush="#1B5E20" 
                                    BorderThickness="1.5" 
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActualizacionLista}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EstaBuscandoActualizacion}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EstaDescargandoActualizacion}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                            <TextBlock Text="Buscar Actualizaciones" 
                                                       FontFamily="{StaticResource Fuente-principal}" 
                                                       FontSize="13" FontWeight="Bold" 
                                                       Foreground="White" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#388E3C"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#1B5E20"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Botón Reiniciar y Aplicar (Visible solo cuando ActualizacionLista es True) -->
                            <Button Command="{Binding ReiniciarYAplicarCommand}" 
                                    Height="40" 
                                    Background="#E65100" 
                                    BorderBrush="#BF360C" 
                                    BorderThickness="1.5" 
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActualizacionLista}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                            <TextBlock Text="Reiniciar y Aplicar" 
                                                       FontFamily="{StaticResource Fuente-principal}" 
                                                       FontSize="13" FontWeight="Bold" 
                                                       Foreground="White" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#F57C00"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#BF360C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <!--#endregion-->

            <!--#region Columna 2: Purga de Ventas Físicas -->
            <Border Grid.Column="2" Background="{StaticResource Blanco}" CornerRadius="12" BorderThickness="1.5" BorderBrush="#E57373">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Borrado Físico de Ventas"
                                   FontFamily="{StaticResource Fuente-principal}"
                                   FontSize="19" FontWeight="Bold" Foreground="#C62828"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,14"/>

                        <Border Background="#FFEBEE" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                            <TextBlock Text="ATENCIÓN: Las ventas se eliminarán definitivamente de la base de datos para liberar espacio. Se solicitará el PIN de administrador para confirmar." 
                                       FontFamily="{StaticResource Fuente-principal}" 
                                       FontSize="11" Foreground="#B71C1C" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Días de antigüedad:" 
                                   FontFamily="{StaticResource Fuente-principal}" 
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2"/>

                        <TextBlock Text="Escribe los días o selecciona una opción rápida:" 
                                   FontFamily="{StaticResource Fuente-principal}" 
                                   FontSize="11" Foreground="Gray" 
                                   Margin="0,0,0,4"/>

                        <ComboBox IsEditable="True" 
                                  Text="{Binding DiasPurgaTexto, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding OpcionesDiasPurga}" 
                                  FontFamily="{StaticResource Fuente-principal}"  
                                  FontSize="14"
                                  Height="34" 
                                  Margin="0,0,0,12"/>

                        <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ventas a borrar encontradas:" 
                                               FontFamily="{StaticResource Fuente-principal}" 
                                               FontSize="12" Foreground="#5D4037" FontWeight="SemiBold"/>
                                    <TextBlock Text="con más de los días indicados" 
                                               FontFamily="{StaticResource Fuente-principal}" 
                                               FontSize="10" Foreground="Gray"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding VentasAPurgar}" 
                                           FontFamily="{StaticResource Fuente-principal}" 
                                           FontSize="24" FontWeight="Bold" Foreground="#D84315" 
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>

                        <Button Content="BORRAR VENTAS" 
                                Style="{StaticResource BtnGuardarCambios}"
                                FontFamily="{StaticResource Fuente-principal}"
                                FontSize="15" FontWeight="Bold" Foreground="White"
                                Background="#D32F2F" 
                                Height="42" 
                                Margin="0,0,0,8" 
                                Command="{Binding SolicitarPurgaVentasCommand}"/>

                        <TextBlock Text="{Binding MensajeResultadoPurga}" 
                                   FontFamily="{StaticResource Fuente-principal}" 
                                   FontSize="12" Foreground="#1565C0" TextWrapping="Wrap" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <!--#endregion-->

            <!--#region Columna 4: Hardware Impresora y Cajón -->
            <Border Grid.Column="4" Background="{StaticResource Blanco}" CornerRadius="12" BorderThickness="1.5" BorderBrush="#BDBDBD">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Impresora Térmica &amp; Cajón"
                                   FontFamily="{StaticResource Fuente-principal}"
                                   FontSize="19" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,14"/>

                        <TextBlock Text="Impresora de Tickets / Ventas:"
                                   FontFamily="{StaticResource Fuente-principal}"
                                   FontSize="13" FontWeight="SemiBold"/>

                        <ComboBox ItemsSource="{Binding ImpresorasDisponibles}"
                                  SelectedItem="{Binding ImpresoraSeleccionada}"
                                  Height="34" FontSize="13"
                                  FontFamily="{StaticResource Fuente-principal}"
                                  Margin="0,4,0,12"/>

                        <TextBlock Text="Ancho de Papel:"
                                   FontFamily="{StaticResource Fuente-principal}"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton Content="58 mm (Estándar)" IsChecked="{Binding EsPapel58mm}" 
                                         FontFamily="{StaticResource Fuente-principal}" FontSize="12" Margin="0,0,15,0"/>
                            <RadioButton Content="80 mm" IsChecked="{Binding EsPapel80mm}" 
                                         FontFamily="{StaticResource Fuente-principal}" FontSize="12"/>
                        </StackPanel>

                        <CheckBox Content="Abrir cajón al cobrar en efectivo [F12]"
                                  IsChecked="{Binding AbrirCajonAutomatico}"
                                  FontFamily="{StaticResource Fuente-principal}"
                                  FontSize="12" Margin="0,0,0,8"/>

                        <CheckBox Content="Cortar papel automáticamente"
                                  IsChecked="{Binding CortarPapelAutomatico}"
                                  FontFamily="{StaticResource Fuente-principal}"
                                  FontSize="12" Margin="0,0,0,14"/>

                        <Button Content="Guardar Ajustes" 
                                Style="{StaticResource BtnGuardarCambios}"
                                FontFamily="{StaticResource Fuente-principal}"
                                FontSize="15" FontWeight="SemiBold"
                                Height="40" Margin="0,0,0,10"
                                Command="{Binding GuardarConfiguracionImpresoraCommand}"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" 
                                    Height="36" 
                                    Background="#F5F5F5" 
                                    BorderBrush="#BDBDBD" 
                                    BorderThickness="1.5" 
                                    Cursor="Hand"
                                    Command="{Binding ProbarImpresionCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                            <TextBlock Text="Probar Ticket" 
                                                       FontFamily="{StaticResource Fuente-principal}" 
                                                       FontSize="12" FontWeight="SemiBold" 
                                                       Foreground="#424242" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bdr" Property="Background" Value="#E0E0E0"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bdr" Property="Background" Value="#BDBDBD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="2" 
                                    Height="36" 
                                    Background="#F5F5F5" 
                                    BorderBrush="#BDBDBD" 
                                    BorderThickness="1.5" 
                                    Cursor="Hand"
                                    Command="{Binding ProbarAperturaCajonCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                            <TextBlock Text="Probar Cajón [F12]" 
                                                       FontFamily="{StaticResource Fuente-principal}" 
                                                       FontSize="11" FontWeight="SemiBold" 
                                                       Foreground="#424242" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bdr" Property="Background" Value="#E0E0E0"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bdr" Property="Background" Value="#BDBDBD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <TextBlock Text="{Binding MensajeResultadoImpresora}" 
                                   FontFamily="{StaticResource Fuente-principal}" 
                                   FontSize="11" TextWrapping="Wrap" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TieneErrorImpresora}" Value="True">
                                            <Setter Property="Foreground" Value="#D32F2F"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <!--#endregion-->
        </Grid>
        <!--#endregion-->

        <!--#region MODAL PIN OVERLAY (Teclado Numérico Táctil) -->
        <Grid Grid.RowSpan="2" Background="#A6000000" Visibility="{Binding MostrarModalPin, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="380" Background="White" CornerRadius="16" BorderBrush="Black" BorderThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Encabezado -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="AUTORIZACIÓN" FontFamily="{StaticResource Fuente-principal}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ingrese PIN de administrador" FontFamily="{StaticResource Fuente-principal}" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Visor de PIN enmascarado -->
                    <Border Grid.Row="1" Height="50" Background="#F5F5F5" BorderBrush="Black" BorderThickness="2" CornerRadius="8" Margin="0,0,0,6">
                        <TextBlock Text="{Binding PinEnmascarado}" FontFamily="{StaticResource Fuente-principal}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#212121" Margin="10,0"/>
                    </Border>

                    <!-- Mensaje de error -->
                    <TextBlock Grid.Row="2" Text="{Binding MensajeErrorPin}" FontFamily="{StaticResource Fuente-principal}" FontSize="13" Foreground="Red" HorizontalAlignment="Center" Margin="0,0,0,8" Height="18" TextTrimming="CharacterEllipsis"/>

                    <!-- Teclado Numérico Táctil -->
                    <UniformGrid Grid.Row="3" Rows="4" Columns="3" Margin="0,0,0,15">
                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="1" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="1"/>
                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="2" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="2"/>
                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="3" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="3"/>

                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="4" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="4"/>
                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="5" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="5"/>
                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="6" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="6"/>

                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="7" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="7"/>
                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="8" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="8"/>
                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="9" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="9"/>

                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="22" FontWeight="Bold" Foreground="#C62828" Content="C" Command="{Binding LimpiarPinCommand}"/>
                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="0" Command="{Binding AgregarDigitoPinCommand}" CommandParameter="0"/>
                        <Button Style="{StaticResource BtnTecladoNumerico}" Height="54" Margin="3" Command="{Binding BorrarDigitoPinCommand}">
                            <Image Source="/Assets/Imagenes/Icono_eliminacion_teclado.png" Height="26" Width="26" Stretch="Uniform"/>
                        </Button>
                    </UniformGrid>

                    <!-- Botones de Acción Modal con estilo inline -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" 
                                Command="{Binding CancelarPinCommand}" 
                                Height="45" Margin="0,0,6,0"
                                Background="#F5F5F5"
                                BorderBrush="#BDBDBD"
                                BorderThickness="1.5"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                        <TextBlock Text="CANCELAR" 
                                                   FontFamily="{StaticResource Fuente-principal}" 
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="#616161"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bdr" Property="Background" Value="#E0E0E0"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bdr" Property="Background" Value="#BDBDBD"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding ConfirmarPinCommand}" Style="{StaticResource BtnGuardarCambios}" Height="45" Margin="6,0,0,0" FontFamily="{StaticResource Fuente-principal}" FontSize="16" FontWeight="Bold" Content="CONFIRMAR"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>