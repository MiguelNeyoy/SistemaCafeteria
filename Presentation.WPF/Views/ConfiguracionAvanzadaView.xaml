<UserControl x:Class="Presentation.WPF.Views.ConfiguracionAvanzadaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Presentation.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--#region Cambiar NIP-->
        <Border Grid.Column="0" Height="auto" Background="{StaticResource Blanco}" CornerRadius="15" BorderThickness="2" BorderBrush="Gray">

            <StackPanel Margin="10">


                <TextBlock Text="Cambiar PIN de Administrador"
                           FontFamily="{StaticResource Fuente-principal}"
                           FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,30"/>


                <TextBlock Text="PIN Actual:"
                           FontFamily="{StaticResource Fuente-principal}"
                           FontSize="16"/>

                <TextBox Text="{Binding PinActual, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                         FontFamily="{StaticResource Fuente-principal}"
                         FontSize="14"
                         Margin="0,4,0,20" Padding="5,0"
                         Height="30"/>

                <TextBlock Text="Nuevo PIN (minimo 4 digitos)"
                           FontFamily="{StaticResource Fuente-principal}"
                           FontSize="16"/>

                <TextBox Text="{Binding PinNuevo, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                         FontFamily="{StaticResource Fuente-principal}"
                         FontSize="14"
                         Margin="0,4,0,20" Padding="5,0"
                         Height="30"/>

                <Button Content="Actualizar PIN" Style="{StaticResource BtnGuardarCambios}"
                        FontFamily="{StaticResource Fuente-principal}"
                        FontSize="18" FontWeight="SemiBold"
                        Margin="30,10,30,0" Height="40"
                        Command="{Binding CambiarPinCommand}"/>


            </StackPanel>

        </Border>
        <!--#endregion-->


        <!--#region Purga de ventas fisicas-->
        <Border Grid.Column="2" Height="auto" Background="{StaticResource Blanco}" CornerRadius="15" BorderThickness="2" BorderBrush="Gray">

            <StackPanel Margin="10">

                <TextBlock Text="Borrado fisico de ventas"
                           FontFamily="{StaticResource Fuente-principal}"
                           FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,20"/>

                <TextBlock Text="⚠️ ATENCIÓN: Las ventas se eliminarán definitivamente de la base de datos para liberar espacio. Se solicitará el PIN de administrador." 
                           FontFamily="{StaticResource Fuente-principal}" 
                           FontSize="11" Foreground="#B71C1C" TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Escribe los días o selecciona una opción rápida:" 
                           FontFamily="{StaticResource Fuente-principal}" 
                           FontSize="11" Foreground="Gray" 
                           Margin="0,8,0,4"/>

                <ComboBox IsEditable="True" Text="{Binding DiasPurgaTexto, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding OpcionesDiasPurga}" 
                          FontFamily="{StaticResource Fuente-principal}"  
                          FontSize="15"
                          Height="32" 
                          Margin="0,0,0,8"/>

                <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,10">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="Ventas a borrar encontradas:" 
                                       FontFamily="{StaticResource Fuente-principal}"
                                       FontSize="11" Foreground="#5D4037"/>

                            <TextBlock Text="con más de los días indicados" 
                                       FontFamily="{StaticResource Fuente-principal}" 
                                       FontSize="9" Foreground="Gray"/>

                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding VentasAPurgar}" 
                                   FontFamily="{StaticResource Fuente-principal}" 
                                   FontSize="20" FontWeight="Bold" Foreground="#D84315" 
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>

                    </Grid>

                </Border>

                <Button Content="🗑️ BORRAR VENTAS" Style="{StaticResource BtnGuardarCambios}"
                        FontFamily="{StaticResource Fuente-principal}"
                        FontSize="14" FontWeight="Bold" Foreground="White"
                        Background="#D32F2F" 
                        Height="38" 
                        Margin="0,0,0,6" 
                        Command="{Binding SolicitarPurgaVentasCommand}"/>


                <TextBlock Text="{Binding MensajeResultadoPurga}" 
                           FontFamily="{StaticResource Fuente-principal}" 
                           FontSize="11" Foreground="#1565C0" TextWrapping="Wrap" FontWeight="SemiBold"
                           Margin="0,4,0,0"/>

            </StackPanel>

        </Border>
        <!--#endregion-->

        <!--#region Hardware Impresora y Cajon-->
        <Border Grid.Column="4" Height="auto" Background="{StaticResource Blanco}" CornerRadius="15" BorderThickness="2" BorderBrush="Gray">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">

                    <TextBlock Text="Impresora Térmica &amp; Cajón"
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,15,0,15"/>

                    <TextBlock Text="Impresora de Tickets / Comprobantes:"
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="13" FontWeight="SemiBold"/>

                    <ComboBox ItemsSource="{Binding ImpresorasDisponibles}"
                              SelectedItem="{Binding ImpresoraSeleccionada}"
                              Height="32" FontSize="13"
                              FontFamily="{StaticResource Fuente-principal}"
                              Margin="0,4,0,12"/>

                    <TextBlock Text="Ancho de Papel:"
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton Content="58 mm (Estándar)" IsChecked="{Binding EsPapel58mm}" 
                                     FontFamily="{StaticResource Fuente-principal}" FontSize="12" Margin="0,0,15,0"/>
                        <RadioButton Content="80 mm" IsChecked="{Binding EsPapel80mm}" 
                                     FontFamily="{StaticResource Fuente-principal}" FontSize="12"/>
                    </StackPanel>

                    <CheckBox Content="Abrir cajón al cobrar en efectivo [F12]"
                              IsChecked="{Binding AbrirCajonAutomatico}"
                              FontFamily="{StaticResource Fuente-principal}"
                              FontSize="12" Margin="0,0,0,8"/>

                    <CheckBox Content="Cortar papel automáticamente"
                              IsChecked="{Binding CortarPapelAutomatico}"
                              FontFamily="{StaticResource Fuente-principal}"
                              FontSize="12" Margin="0,0,0,15"/>

                    <Button Content="💾 Guardar Ajustes" Style="{StaticResource BtnGuardarCambios}"
                            FontFamily="{StaticResource Fuente-principal}"
                            FontSize="15" FontWeight="SemiBold"
                            Height="38" Margin="0,0,0,10"
                            Command="{Binding GuardarConfiguracionImpresoraCommand}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="🖨️ Probar Ticket"
                                Style="{StaticResource BtnComentario}"
                                FontFamily="{StaticResource Fuente-principal}"
                                FontSize="12" Height="36"
                                Command="{Binding ProbarImpresionCommand}"/>

                        <Button Grid.Column="2" Content="💵 Probar Cajón [F12]"
                                Style="{StaticResource BtnComentario}"
                                FontFamily="{StaticResource Fuente-principal}"
                                FontSize="11" Height="36"
                                Command="{Binding ProbarAperturaCajonCommand}"/>
                    </Grid>

                    <TextBlock Text="{Binding MensajeResultadoImpresora}"
                               FontFamily="{StaticResource Fuente-principal}"
                               FontSize="11" TextWrapping="Wrap" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#2E7D32"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TieneErrorImpresora}" Value="True">
                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </StackPanel>
            </ScrollViewer>

        </Border>
        <!--#endregion-->

    </Grid>
</UserControl>