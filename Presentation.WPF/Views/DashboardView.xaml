<UserControl x:Class="Presentation.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Fila 0: Barra Superior / Encabezado -->
            <RowDefinition Height="Auto"/>
            <!-- Fila 1: Contenido Principal (Resumen del Día + Top Más Vendidos) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--#region Encabezado Superior -->
        <Border Grid.Row="0" Background="{StaticResource Amarillo claro_fuerte}" BorderBrush="Gray" BorderThickness="0,0,0,2" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Título y Fecha -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Resumen Operativo / Inicio" 
                               FontFamily="{StaticResource Fuente-principal}" 
                               FontSize="26" FontWeight="Bold" 
                               Foreground="#212121"/>
                    <TextBlock Text="{Binding FechaHoyTexto}" 
                               FontFamily="{StaticResource Fuente-principal}" 
                               FontSize="14" Foreground="#616161" 
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Botones de Acción -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Botón Refrescar -->
                    <Button Command="{Binding CargarDatosCommand}" 
                            Style="{StaticResource BtnRefrescar}" 
                            Height="44" Padding="14,6" Margin="0,0,12,0">
                        <TextBlock Text="Actualizar" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Botón Imprimir Desglose en Ticket -->
                    <Button Command="{Binding ImprimirTicketCommand}" 
                            Height="44" Padding="16,6"
                            Background="{StaticResource Naranja}" 
                            BorderBrush="#E65100" BorderThickness="1.5" 
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="Imprimir Desglose en Ticket" 
                                               FontFamily="{StaticResource Fuente-principal}" 
                                               FontSize="15" FontWeight="Bold" 
                                               Foreground="#1A1A1A"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource Naranja 90%}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource Naranja 70%}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <!--#endregion-->

        <!--#region Contenido Principal: Dos Columnas Responsivas -->
        <Grid Grid.Row="1" Margin="14,10,14,12">
            <Grid.ColumnDefinitions>
                <!-- Columna 0: Resumen del Día -->
                <ColumnDefinition Width="6*" MinWidth="340"/>
                <!-- Columna 1: Top Más Vendidos del Mes -->
                <ColumnDefinition Width="4*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!--#region Columna Izquierda: Tarjetas de Resumen del Día -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel Margin="0,0,6,0">

                    <!-- Tarjeta Principal: Total Vendido del Día -->
                    <Border Background="White" CornerRadius="10" BorderBrush="#E0E0E0" BorderThickness="1.5" Padding="18,14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="VENTAS TOTALES DEL DÍA" 
                                           FontFamily="{StaticResource Fuente-principal}" 
                                           FontSize="13" FontWeight="Bold" 
                                           Foreground="#757575"/>
                                <TextBlock Text="{Binding TotalVentasHoy, StringFormat={}{0:C}}" 
                                           FontFamily="{StaticResource Fuente-principal}" 
                                           FontSize="36" FontWeight="Bold" 
                                           Foreground="#E65100" 
                                           Margin="0,4,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CantidadVentasHoy, StringFormat='{}{0} transacciones cobradas'}" 
                                               FontFamily="{StaticResource Fuente-principal}" 
                                               FontSize="13" Foreground="#424242" FontWeight="SemiBold"/>
                                    <TextBlock Text="  •  " 
                                               FontFamily="{StaticResource Fuente-principal}" 
                                               FontSize="13" Foreground="#BDBDBD"/>
                                    <TextBlock Text="{Binding TicketPromedioHoy, StringFormat='{}Promedio: {0:C}'}" 
                                               FontFamily="{StaticResource Fuente-principal}" 
                                               FontSize="13" Foreground="#424242"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Background="{StaticResource Naranja claro}" CornerRadius="14" Width="68" Height="68" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="$" FontFamily="{StaticResource Fuente-principal}" FontSize="36" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Fila de Métodos de Pago (Efectivo, Tarjeta, Transferencia) -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Efectivo -->
                        <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#C8E6C9" BorderThickness="1.5" Padding="12,10" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Efectivo" FontFamily="{StaticResource Fuente-principal}" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32"/>
                                <TextBlock Text="{Binding TotalEfectivoHoy, StringFormat={}{0:C}}" FontFamily="{StaticResource Fuente-principal}" FontSize="22" FontWeight="Bold" Foreground="#1B5E20" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta -->
                        <Border Grid.Column="1" Background="White" CornerRadius="10" BorderBrush="#BBDEFB" BorderThickness="1.5" Padding="12,10" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Tarjeta" FontFamily="{StaticResource Fuente-principal}" FontSize="13" FontWeight="SemiBold" Foreground="#1565C0"/>
                                <TextBlock Text="{Binding TotalTarjetaHoy, StringFormat={}{0:C}}" FontFamily="{StaticResource Fuente-principal}" FontSize="22" FontWeight="Bold" Foreground="#0D47A1" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Transferencia -->
                        <Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#D1C4E9" BorderThickness="1.5" Padding="12,10" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Transferencia" FontFamily="{StaticResource Fuente-principal}" FontSize="13" FontWeight="SemiBold" Foreground="#6A1B9A"/>
                                <TextBlock Text="{Binding TotalTransferenciaHoy, StringFormat={}{0:C}}" FontFamily="{StaticResource Fuente-principal}" FontSize="22" FontWeight="Bold" Foreground="#4A148C" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Fila Operativa: Cuentas Abiertas y Descuentos -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cuentas Abiertas -->
                        <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#FFE082" BorderThickness="1.5" Padding="14,10" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Cuentas Abiertas" FontFamily="{StaticResource Fuente-principal}" FontSize="13" FontWeight="SemiBold" Foreground="#E65100"/>
                                <TextBlock Text="{Binding CuentasAbiertasCount, StringFormat='{}{0} activas'}" FontFamily="{StaticResource Fuente-principal}" FontSize="22" FontWeight="Bold" Foreground="#212121" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding CuentasAbiertasTotal, StringFormat='{}Por cobrar: {0:C}'}" FontFamily="{StaticResource Fuente-principal}" FontSize="12" Foreground="#757575"/>
                            </StackPanel>
                        </Border>

                        <!-- Descuentos del Día -->
                        <Border Grid.Column="1" Background="White" CornerRadius="10" BorderBrush="#CFD8DC" BorderThickness="1.5" Padding="14,10" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Descuentos del Día" FontFamily="{StaticResource Fuente-principal}" FontSize="13" FontWeight="SemiBold" Foreground="#546E7A"/>
                                <TextBlock Text="{Binding TotalDescuentosHoy, StringFormat={}{0:C}}" FontFamily="{StaticResource Fuente-principal}" FontSize="22" FontWeight="Bold" Foreground="#37474F" Margin="0,3,0,0"/>
                                <TextBlock Text="Promociones y cortesías" FontFamily="{StaticResource Fuente-principal}" FontSize="12" Foreground="#757575"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
            <!--#endregion-->

        <!--#region Columna Derecha: Top Más Vendidos y Ventas Recientes -->
        <Grid Grid.Column="1" Margin="4,0,0,0">
            <Grid.RowDefinitions>
                <!-- Fila 0: Top Más Vendidos del Mes -->
                <RowDefinition Height="*"/>
                <!-- Fila 1: Ventas Más Recientes del Día -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--#region Tarjeta 1: Top Más Vendidos -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" BorderBrush="#BDBDBD" BorderThickness="1.5" Padding="14,10" Margin="0,0,0,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Encabezado de la Tarjeta -->
                        <RowDefinition Height="Auto"/>
                        <!-- Lista de Productos -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1.5" Padding="0,0,0,6" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Top Más Vendidos" FontFamily="{StaticResource Fuente-principal}" FontSize="17" FontWeight="Bold" Foreground="#212121"/>
                                <TextBlock Text="{Binding MesActualTexto, StringFormat='{}Acumulado en {0}'}" FontFamily="{StaticResource Fuente-principal}" FontSize="11" Foreground="#757575"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource Naranja claro}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="Mes Actual" FontFamily="{StaticResource Fuente-principal}" FontSize="11" FontWeight="Bold" Foreground="#E65100"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Lista de Top Productos -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- Listado cuando existen ventas -->
                            <ItemsControl ItemsSource="{Binding TopProductos}" Visibility="{Binding TieneTopProductos, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="4,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Posición (#1, #2, #3...) -->
                                                    <ColumnDefinition Width="30"/>
                                                    <!-- Nombre y Unidades -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- Monto Total Recaudado -->
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Insignia de Posición -->
                                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="{StaticResource Naranja}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Posicion}" FontFamily="{StaticResource Fuente-principal}" FontSize="12" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Nombre y Cantidad -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,6,0">
                                                    <TextBlock Text="{Binding Nombre}" FontFamily="{StaticResource Fuente-principal}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#212121"/>
                                                    <TextBlock Text="{Binding CantidadVendida, StringFormat='{}{0} unidades vendidas'}" FontFamily="{StaticResource Fuente-principal}" FontSize="11" Foreground="#757575" Margin="0,1,0,0"/>
                                                </StackPanel>

                                                <!-- Total Recaudado -->
                                                <TextBlock Grid.Column="2" Text="{Binding TotalRecaudado, StringFormat={}{0:C}}" FontFamily="{StaticResource Fuente-principal}" FontSize="14" FontWeight="Bold" Foreground="#E65100" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Estado Vacío cuando no hay ventas en el mes -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TieneTopProductos}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="No hay ventas registradas" FontFamily="{StaticResource Fuente-principal}" FontSize="14" FontWeight="SemiBold" Foreground="#9E9E9E" HorizontalAlignment="Center"/>
                                <TextBlock Text="Las ventas pagadas de este mes aparecerán aquí" FontFamily="{StaticResource Fuente-principal}" FontSize="11" Foreground="#BDBDBD" HorizontalAlignment="Center" Margin="0,3,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
            <!--#endregion-->

            <!--#region Tarjeta 2: Ventas Más Recientes de Hoy -->
            <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#BDBDBD" BorderThickness="1.5" Padding="14,10" Margin="0,5,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Encabezado de la Tarjeta -->
                        <RowDefinition Height="Auto"/>
                        <!-- Lista de Ventas -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1.5" Padding="0,0,0,6" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ventas Recientes" FontFamily="{StaticResource Fuente-principal}" FontSize="17" FontWeight="Bold" Foreground="#212121"/>
                                <TextBlock Text="Últimos cobros registrados hoy" FontFamily="{StaticResource Fuente-principal}" FontSize="11" Foreground="#757575"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#E8F5E9" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="Hoy" FontFamily="{StaticResource Fuente-principal}" FontSize="11" FontWeight="Bold" Foreground="#2E7D32"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Lista de Ventas Recientes -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- Listado de ventas recientes -->
                            <ItemsControl ItemsSource="{Binding VentasRecientes}" Visibility="{Binding TieneVentasRecientes, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="4,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Folio Ticket -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- Cliente y Hora -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- Total y Tipo de Pago -->
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Folio -->
                                                <Border Grid.Column="0" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="5" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding FolioTexto}" FontFamily="{StaticResource Fuente-principal}" FontSize="12" FontWeight="Bold" Foreground="#E65100"/>
                                                </Border>

                                                <!-- Cliente y Hora -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Cliente}" FontFamily="{StaticResource Fuente-principal}" FontSize="13" FontWeight="SemiBold" Foreground="#212121" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding HoraTexto}" FontFamily="{StaticResource Fuente-principal}" FontSize="11" Foreground="#757575" Margin="0,1,0,0"/>
                                                </StackPanel>

                                                <!-- Total y Método de Pago -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Total, StringFormat={}{0:C}}" FontFamily="{StaticResource Fuente-principal}" FontSize="14" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding TipoPagoTexto}" FontFamily="{StaticResource Fuente-principal}" FontSize="11" Foreground="#757575" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Estado Vacío cuando no hay ventas hoy -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TieneVentasRecientes}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Sin ventas cobradas hoy" FontFamily="{StaticResource Fuente-principal}" FontSize="14" FontWeight="SemiBold" Foreground="#9E9E9E" HorizontalAlignment="Center"/>
                                <TextBlock Text="Los cobros que realices hoy aparecerán aquí" FontFamily="{StaticResource Fuente-principal}" FontSize="11" Foreground="#BDBDBD" HorizontalAlignment="Center" Margin="0,3,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
            <!--#endregion-->

        </Grid>
        <!--#endregion-->

        </Grid>
        <!--#endregion-->

    </Grid>
</UserControl>
