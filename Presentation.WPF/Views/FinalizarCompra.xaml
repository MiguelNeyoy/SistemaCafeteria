<UserControl x:Class="Presentation.WPF.Views.FinalizarCompra"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Presentation.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1000">
    <Grid>


        <!--#region Estructura inicial-->
        <Grid.RowDefinitions>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--#endregion-->


        <!--#region Fila Superior( Boton de retroceso ) -->
        <Border Grid.Row="0" Background="{StaticResource Fondo70%}" BorderBrush="Gray" BorderThickness="0,0,0,2">
            
        </Border>
        <!--#endregion-->
        
        
        <!--#region Fila Inferior ( Resumen de Comanda, Metodos de pago y Teclado )-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            
            <!--#region Columna Izquierda ( Resumen de Comanda ) -->
            <Border Grid.Column="0" Background="{StaticResource Amarillo-claro70%}" BorderBrush="Gray" BorderThickness="0,0,2,0">

                <Border Background="{StaticResource Naranjan-claro}" BorderBrush="Gray" BorderThickness="2" CornerRadius="10" Height="700" Width="360">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition  Height="50"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="80"/>
                        </Grid.RowDefinitions>
                        
                        
                        <!--#region Encabezado o Titulo-->
                        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="0,0,0,1">
                            <TextBlock FontFamily="{StaticResource Fuente-principal}" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Resumen de compra"/>
                        </Border>
                        <!--#endregion-->
                        
                        
                        <!--#region Resumen de productos-->
                        <ListBox Grid.Row="1">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding CantidadTotal}" />
                                        <TextBlock Grid.Column="1" Text="{Binding NombrePrdocuto}" />
                                        <TextBlock Grid.Column="2" Text="{Binding PrecioTotal}" />

                                    </Grid>
                                    
                                </DataTemplate>
                                
                            </ItemsControl.ItemTemplate>

                        </ListBox>
                        <!--#endregion-->
                        
                        
                        <!--#region Total-->
                        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock FontFamily="{StaticResource Fuente-principal}" FontSize="24" HorizontalAlignment="Center" Margin="0,10,0,0" Text="Total $"/>
                                <TextBlock FontFamily="{StaticResource Fuente-principal}" FontSize="24" HorizontalAlignment="Center" Margin="0,10,0,0" Text="{Binding MontoTotal}"/>

                            </Grid>
                        <!--#endregion-->
                            

                        </Border>

                    </Grid>
                </Border>

            </Border>
            <!--#endregion-->


            <!--#region Columna Derecha ( Metodos de Pago, Teclado y Boton de "Confirmar Compra" ) -->
            <Grid Grid.Column="1" Background="{StaticResource Amarillo-claro70%}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>
                
                
                <!--#region Metodos de Pago-->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource BtnMetodosdePago}" Height="60" Width="170"  FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="Efectivo"/>
                    <Button Grid.Column="1" Style="{StaticResource BtnMetodosdePago}" Height="60" Width="170"  FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="Tarjeta"/>
                    <Button Grid.Column="2" Style="{StaticResource BtnMetodosdePago}" Height="60" Width="170"  FontFamily="{StaticResource Fuente-principal}" FontSize="26" Content="Transferencia"/>


                </Grid>
                <!--#endregion-->

                
                <!--#region Panel de cobro-->
                <Border Grid.Row="1" Background="{StaticResource Naranja-claro90%}" BorderBrush="Gray" BorderThickness="2" CornerRadius="10" Width="600">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!--#region Modulo 1. Visor de importe -->
                        <Border Grid.Row="0" Background="White" BorderBrush="Black" BorderThickness="2" CornerRadius="6" Height="70" Width="540">
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource Fuente-principal}" FontSize="18" Margin="20,0,0,0">Cantidad recibida:</TextBlock>
                                <TextBlock FontFamily="{StaticResource Fuente-principal}" FontSize="30" HorizontalAlignment="Right" Margin="0,0,10,0">$0.00</TextBlock>
                            </StackPanel>
                        </Border>
                        <!--#endregion-->


                        <!--#region Modulo 2. Teclado numerico -->
                        <UniformGrid Grid.Row="1" Rows="4" Columns="3" >

                            <Button Style="{StaticResource BtnTecladoNumerico}" Height="95" Width="180" FontFamily="{StaticResource Fuente-principal}" FontSize="85" Content="7"/>
                            <Button Style="{StaticResource BtnTecladoNumerico}" Height="95" Width="180" FontFamily="{StaticResource Fuente-principal}" FontSize="85" Content="8"/>
                            <Button Style="{StaticResource BtnTecladoNumerico}" Height="95" Width="180" FontFamily="{StaticResource Fuente-principal}" FontSize="85" Content="9"/>
                            <Button Style="{StaticResource BtnTecladoNumerico}" Height="95" Width="180" FontFamily="{StaticResource Fuente-principal}" FontSize="85" Content="4"/>
                            <Button Style="{StaticResource BtnTecladoNumerico}" Height="95" Width="180" FontFamily="{StaticResource Fuente-principal}" FontSize="85" Content="5"/>
                            <Button Style="{StaticResource BtnTecladoNumerico}" Height="95" Width="180" FontFamily="{StaticResource Fuente-principal}" FontSize="85" Content="6"/>
                            <Button Style="{StaticResource BtnTecladoNumerico}" Height="95" Width="180" FontFamily="{StaticResource Fuente-principal}" FontSize="85" Content="1"/>
                            <Button Style="{StaticResource BtnTecladoNumerico}" Height="95" Width="180" FontFamily="{StaticResource Fuente-principal}" FontSize="85" Content="2"/>
                            <Button Style="{StaticResource BtnTecladoNumerico}" Height="95" Width="180" FontFamily="{StaticResource Fuente-principal}" FontSize="85" Content="3"/>
                            <Button Style="{StaticResource BtnTecladoNumerico}" Height="95" Width="180" FontFamily="{StaticResource Fuente-principal}" FontSize="85" Content="0"/>
                            <Button Style="{StaticResource BtnTecladoNumerico}" Height="95" Width="180" FontFamily="{StaticResource Fuente-principal}" FontSize="85" Content="00"/>
                            <Button Style="{StaticResource BtnTecladoNumerico}" Height="95" Width="180" FontFamily="{StaticResource Fuente-principal}" FontSize="85">
                                <Image Source="/Assets/Imagenes/Icono_eliminacion_teclado.png" Stretch="Uniform"/>
                            </Button>

                        </UniformGrid>
                        <!--#endregion-->


                    </Grid>
                </Border>
                <!--#endregion-->
                
                
                <!--#region Boton "Confirmar Compra"-->
                <Border Grid.Row="2" Background="{StaticResource Boton-interactivo}" BorderBrush="Black" BorderThickness="2" CornerRadius="10" Height="90" Width="600">

                    <Button Style="{StaticResource BtnDePago}" Height="85" Width="280">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0" Text="Confirmar Pago" FontFamily="{StaticResource Fuente-principal}" FontSize="26"/>
                            <Image Grid.Column="1" Source="/Assets/Imagenes/Icono_confirmacion.png" Height="45" Width="auto" Stretch="Uniform"/>

                        </Grid>
                    </Button>
                    
                </Border>
                <!--#endregion-->
                

            </Grid>
            <!--#endregion-->

            
        </Grid>
        <!--#endregion-->


    </Grid>
</UserControl>