<UserControl x:Class="Presentation.WPF.Views.FinalizarCompra"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Presentation.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Estilo para Teclas Numericas Tactiles -->
        <Style x:Key="BtnKeypadNumerico" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontFamily" Value="{StaticResource Fuente-principal}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFF8E1"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFA000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Naranja}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E65100"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para Billetes Rapidos -->
        <Style x:Key="BtnBilleteRapido" TargetType="Button">
            <Setter Property="Background" Value="#E8F5E9"/>
            <Setter Property="Foreground" Value="#1B5E20"/>
            <Setter Property="BorderBrush" Value="#81C784"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontFamily" Value="{StaticResource Fuente-principal}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C8E6C9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A5D6A7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para Metodos de Pago -->
        <Style x:Key="BtnOpcionPago" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily" Value="{StaticResource Fuente-principal}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFF8E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Amarillo claro_bajo}">
        <!--#region Estructura Principal -->
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--#endregion-->

        <!--#region Barra Superior -->
        <Border Grid.Row="0" Background="{StaticResource Amarillo claro_fuerte}" BorderBrush="Gray" BorderThickness="0,0,0,2">
            <Grid Margin="15,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Boton de retroceso -->
                <Button Grid.Column="0" 
                        Command="{Binding RegresarCommand}" 
                        Style="{StaticResource BotonRetroceso}" 
                        Height="58" Width="105" 
                        VerticalAlignment="Center">
                    <Image Source="/Assets/Imagenes/Icono_retroceso.png" Stretch="Uniform"/>
                </Button>

                <!-- Titulo y Detalle de la Cuenta -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="Cobro de Cuenta" 
                               FontFamily="{StaticResource Fuente-principal}" 
                               FontSize="26" FontWeight="Bold" 
                               Foreground="#212121"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding VentaId, StringFormat='Ticket #{0}'}" 
                                   FontFamily="{StaticResource Fuente-principal}" 
                                   FontSize="15" FontWeight="SemiBold" 
                                   Foreground="#E65100"/>
                        <TextBlock Text=" - Cliente / Mesa: " 
                                   FontFamily="{StaticResource Fuente-principal}" 
                                   FontSize="15" Foreground="#757575"/>
                        <TextBlock Text="{Binding Cliente}" 
                                   FontFamily="{StaticResource Fuente-principal}" 
                                   FontSize="15" FontWeight="Bold" 
                                   Foreground="#424242"/>
                    </StackPanel>
                </StackPanel>

                <!-- Badge de Total a Cobrar -->
            </Grid>
        </Border>
        <!--#endregion-->

        <!--#region Cuerpo: Resumen y Panel de Cobro -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="410"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--#region Columna Izquierda: Resumen de Compra -->
            <Border Grid.Column="0" Background="White" BorderBrush="#BDBDBD" BorderThickness="0,0,2,0" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Encabezado de la comanda -->
                    <Border Grid.Row="0" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1.5" Padding="0,0,0,10" Margin="0,0,0,8">
                        <TextBlock Text="Resumen de la Orden" 
                                   FontFamily="{StaticResource Fuente-principal}" 
                                   FontSize="20" FontWeight="Bold" 
                                   Foreground="#212121"/>
                    </Border>

                    <!-- Lista de productos con extras y notas -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="4,8" Margin="0,0,4,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Cantidad -->
                                            <Border Grid.Column="0" Background="#FFF3E0" CornerRadius="4" Padding="6,2" VerticalAlignment="Top" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Cantidad, StringFormat='{}{0}x'}" 
                                                           FontFamily="{StaticResource Fuente-principal}" 
                                                           FontSize="14" FontWeight="Bold" 
                                                           Foreground="#E65100"/>
                                            </Border>

                                            <!-- Nombre del producto -->
                                            <TextBlock Grid.Column="1" Text="{Binding ProductoNombre}" 
                                                       FontFamily="{StaticResource Fuente-principal}" 
                                                       FontSize="16" FontWeight="SemiBold" 
                                                       Foreground="#212121" 
                                                       TextWrapping="Wrap" 
                                                       VerticalAlignment="Top"/>

                                            <!-- Subtotal -->
                                            <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat={}{0:C}}" 
                                                       FontFamily="{StaticResource Fuente-principal}" 
                                                       FontSize="16" FontWeight="Bold" 
                                                       Foreground="#424242" 
                                                       VerticalAlignment="Top" 
                                                       Margin="8,0,0,0"/>

                                            <!-- Lista de Extras -->
                                            <ItemsControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" 
                                                          ItemsSource="{Binding Extras}" 
                                                          Visibility="{Binding TieneExtras, Converter={StaticResource BoolToVisConverter}}" 
                                                          Margin="0,3,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" 
                                                                   FontFamily="{StaticResource Fuente-principal}" 
                                                                   FontSize="13" 
                                                                   Foreground="#E65100" 
                                                                   Margin="0,1"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Nota / Instruccion -->
                                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" 
                                                       Text="{Binding Notas, StringFormat='Nota: {0}'}" 
                                                       FontFamily="{StaticResource Fuente-principal}" 
                                                       FontSize="12" FontStyle="Italic" 
                                                       Foreground="#757575" 
                                                       Visibility="{Binding TieneNotas, Converter={StaticResource BoolToVisConverter}}" 
                                                       Margin="0,2,0,0" 
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Desglose de Totales Financieros -->
                    <Border Grid.Row="2" Background="#FFFDE7" BorderBrush="#FFE082" BorderThickness="1.5" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Subtotal" FontFamily="{StaticResource Fuente-principal}" FontSize="15" Foreground="#757575"/>
                                <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat={}{0:C}}" FontFamily="{StaticResource Fuente-principal}" FontSize="15" FontWeight="SemiBold"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Descuento" FontFamily="{StaticResource Fuente-principal}" FontSize="14" Foreground="#388E3C"/>
                                <TextBlock Grid.Column="1" Text="{Binding Descuento, StringFormat='-{0:C}'}" FontFamily="{StaticResource Fuente-principal}" FontSize="14" FontWeight="Bold" Foreground="#388E3C"/>
                            </Grid>

                            <Border Grid.Row="2" BorderBrush="#FFE082" BorderThickness="0,1.5,0,0" Padding="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total a Pagar" FontFamily="{StaticResource Fuente-principal}" FontSize="20" FontWeight="Bold" Foreground="#212121" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat={}{0:C}}" FontFamily="{StaticResource Fuente-principal}" FontSize="26" FontWeight="Bold" Foreground="#E65100" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <!--#endregion-->

            <!--#region Columna Derecha: Metodos de Pago, Teclado Tactil y Confirmacion -->
            <Grid Grid.Column="1" Margin="20,15,20,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Selector de Metodo de Pago (Botones Tactiles) -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Efectivo -->
                    <Button Grid.Column="0" 
                            Command="{Binding SeleccionarTipoPagoCommand}" 
                            CommandParameter="Efectivo">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BtnOpcionPago}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsEfectivo}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Naranja}"/>
                                        <Setter Property="Foreground" Value="#1A1A1A"/>
                                        <Setter Property="BorderBrush" Value="#E65100"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Efectivo" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Tarjeta -->
                    <Button Grid.Column="1" 
                            Command="{Binding SeleccionarTipoPagoCommand}" 
                            CommandParameter="Tarjeta">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BtnOpcionPago}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsTarjeta}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Naranja}"/>
                                        <Setter Property="Foreground" Value="#1A1A1A"/>
                                        <Setter Property="BorderBrush" Value="#E65100"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Tarjeta" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Transferencia -->
                    <Button Grid.Column="2" 
                            Command="{Binding SeleccionarTipoPagoCommand}" 
                            CommandParameter="Transferencia">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BtnOpcionPago}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsTransferencia}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Naranja}"/>
                                        <Setter Property="Foreground" Value="#1A1A1A"/>
                                        <Setter Property="BorderBrush" Value="#E65100"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Transferencia" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- Panel Central: Efectivo (Visor, Billetes Rapidos y Teclado) -->
                <Border Grid.Row="1" 
                        Background="White" 
                        BorderBrush="#BDBDBD" 
                        BorderThickness="1.5" 
                        CornerRadius="12" 
                        Padding="16,12" 
                        Visibility="{Binding EsEfectivo, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Visor de Monto Recibido y Cambio -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tarjeta Monto Recibido -->
                            <Border Grid.Column="0" Background="#F5F5F5" BorderBrush="#BDBDBD" BorderThickness="1.5" CornerRadius="10" Padding="14,8">
                                <StackPanel>
                                    <TextBlock Text="Efectivo Recibido:" 
                                               FontFamily="{StaticResource Fuente-principal}" 
                                               FontSize="14" FontWeight="SemiBold" 
                                               Foreground="#616161"/>
                                    <TextBlock Text="{Binding MontoRecibido, StringFormat={}{0:C}}" 
                                               FontFamily="{StaticResource Fuente-principal}" 
                                               FontSize="28" FontWeight="Bold" 
                                               Foreground="#212121" 
                                               HorizontalAlignment="Right" 
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Tarjeta Cambio a Entregar -->
                            <Border Grid.Column="2" CornerRadius="10" Padding="14,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#E8F5E9"/>
                                        <Setter Property="BorderBrush" Value="#81C784"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MontoEsSuficiente}" Value="False">
                                                <Setter Property="Background" Value="#FFEBEE"/>
                                                <Setter Property="BorderBrush" Value="#E57373"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Cambio a Devolver:" 
                                               FontFamily="{StaticResource Fuente-principal}" 
                                               FontSize="14" FontWeight="SemiBold" 
                                               Foreground="#2E7D32">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MontoEsSuficiente}" Value="False">
                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                        <Setter Property="Text" Value="Falta por cubrir:"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Cambio, StringFormat={}{0:C}}" 
                                               FontFamily="{StaticResource Fuente-principal}" 
                                               FontSize="28" FontWeight="Bold" 
                                               Foreground="#2E7D32" 
                                               HorizontalAlignment="Right" 
                                               Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MontoEsSuficiente}" Value="False">
                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Fila de Billetes Rapidos -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Exacto" Style="{StaticResource BtnBilleteRapido}" Command="{Binding EstablecerMontoRapidoCommand}" CommandParameter="Exacto"/>
                            <Button Grid.Column="1" Content="$50" Style="{StaticResource BtnBilleteRapido}" Command="{Binding EstablecerMontoRapidoCommand}" CommandParameter="50"/>
                            <Button Grid.Column="2" Content="$100" Style="{StaticResource BtnBilleteRapido}" Command="{Binding EstablecerMontoRapidoCommand}" CommandParameter="100"/>
                            <Button Grid.Column="3" Content="$200" Style="{StaticResource BtnBilleteRapido}" Command="{Binding EstablecerMontoRapidoCommand}" CommandParameter="200"/>
                            <Button Grid.Column="4" Content="$500" Style="{StaticResource BtnBilleteRapido}" Command="{Binding EstablecerMontoRapidoCommand}" CommandParameter="500"/>
                            <Button Grid.Column="5" Content="$1000" Style="{StaticResource BtnBilleteRapido}" Command="{Binding EstablecerMontoRapidoCommand}" CommandParameter="1000"/>
                        </Grid>

                        <!-- Teclado Numerico Tactil -->
                        <UniformGrid Grid.Row="2" Rows="4" Columns="3">
                            <Button Style="{StaticResource BtnKeypadNumerico}" Content="7" Command="{Binding IngresarDigitoKeypadCommand}" CommandParameter="7"/>
                            <Button Style="{StaticResource BtnKeypadNumerico}" Content="8" Command="{Binding IngresarDigitoKeypadCommand}" CommandParameter="8"/>
                            <Button Style="{StaticResource BtnKeypadNumerico}" Content="9" Command="{Binding IngresarDigitoKeypadCommand}" CommandParameter="9"/>

                            <Button Style="{StaticResource BtnKeypadNumerico}" Content="4" Command="{Binding IngresarDigitoKeypadCommand}" CommandParameter="4"/>
                            <Button Style="{StaticResource BtnKeypadNumerico}" Content="5" Command="{Binding IngresarDigitoKeypadCommand}" CommandParameter="5"/>
                            <Button Style="{StaticResource BtnKeypadNumerico}" Content="6" Command="{Binding IngresarDigitoKeypadCommand}" CommandParameter="6"/>

                            <Button Style="{StaticResource BtnKeypadNumerico}" Content="1" Command="{Binding IngresarDigitoKeypadCommand}" CommandParameter="1"/>
                            <Button Style="{StaticResource BtnKeypadNumerico}" Content="2" Command="{Binding IngresarDigitoKeypadCommand}" CommandParameter="2"/>
                            <Button Style="{StaticResource BtnKeypadNumerico}" Content="3" Command="{Binding IngresarDigitoKeypadCommand}" CommandParameter="3"/>

                            <!-- Boton Limpiar (C) -->
                            <Button Style="{StaticResource BtnKeypadNumerico}" Content="C" Foreground="#C62828" Command="{Binding LimpiarKeypadCommand}"/>
                            <!-- Boton 0 -->
                            <Button Style="{StaticResource BtnKeypadNumerico}" Content="0" Command="{Binding IngresarDigitoKeypadCommand}" CommandParameter="0"/>
                            <!-- Boton Borrar retroceso -->
                            <Button Style="{StaticResource BtnKeypadNumerico}" Command="{Binding BorrarDigitoKeypadCommand}">
                                <Image Source="/Assets/Imagenes/Icono_eliminacion_teclado.png" Height="32" Width="38" Stretch="Uniform"/>
                            </Button>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- Panel Central Alternativo: Tarjeta o Transferencia -->
                <Border Grid.Row="1" 
                        Background="White" 
                        BorderBrush="#BDBDBD" 
                        BorderThickness="1.5" 
                        CornerRadius="12" 
                        Padding="30">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsEfectivo}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Titulo del modo -->
                            <Border Background="#FFF3E0" CornerRadius="12" Padding="20,10" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <TextBlock Text="{Binding TipoPagoSeleccionado, StringFormat='Pago con {0}'}" 
                                           FontFamily="{StaticResource Fuente-principal}" 
                                           FontSize="24" FontWeight="Bold" 
                                           Foreground="#E65100"/>
                            </Border>

                            <TextBlock Text="Monto total a procesar:" 
                                       FontFamily="{StaticResource Fuente-principal}" 
                                       FontSize="18" Foreground="#616161" 
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding Total, StringFormat={}{0:C}}" 
                                       FontFamily="{StaticResource Fuente-principal}" 
                                       FontSize="48" FontWeight="Bold" 
                                       Foreground="#212121" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,6,0,24"/>

                            <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="20,14" MaxWidth="460">
                                <TextBlock Text="Procese la transaccion en la terminal bancaria o verifique el comprobante de transferencia SPEI y presione Confirmar Pago para finalizar." 
                                           FontFamily="{StaticResource Fuente-principal}" 
                                           FontSize="15" Foreground="#757575" 
                                           TextWrapping="Wrap" 
                                           TextAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Boton Inferior: Confirmar Pago -->
                <Button Grid.Row="2" 
                        Command="{Binding CobrarCommand}" 
                        IsEnabled="{Binding PuedeConfirmarCobro}"
                        Height="68" 
                        Margin="0,14,0,0" 
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource Naranja}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FFB300"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FFA000"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="border" Property="Background" Value="#E0E0E0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="{Binding Total, StringFormat='Confirmar Pago ({0:C})'}" 
                                   FontFamily="{StaticResource Fuente-principal}" 
                                   FontSize="24" FontWeight="Bold" 
                                   Foreground="#1A1A1A" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,15,0"/>

                        <Image Grid.Column="1" 
                               Source="/Assets/Imagenes/Icono_confirmacion.png" 
                               Height="36" Width="36" 
                               Stretch="Uniform" 
                               VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Grid>
            <!--#endregion-->
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>